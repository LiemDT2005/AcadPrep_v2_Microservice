# Copy to `.env` (same folder as docker-compose.yml) and fill in real values. `.env` is gitignored.
# Docker Compose substitutes ${NAME} with these values; each container only receives the variables
# mapped in its own `environment:` block. For F5 (no Docker) use `dotnet user-secrets` instead.

# --- Billing (billing.api) ---
# Set the three connection strings before running Compose.
# Use the Compose SQL host (sqlserver,1433) and the database for each service.
BILLING_CONNECTION_STRING=

# --- Notification (notifications.api) ---
NOTIFICATIONS_CONNECTION_STRING=

# Real SMTP for reminder emails (e.g. a Gmail app password). Leave SMTP_HOST/SMTP_FROM empty to keep
# reminders in-app only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# --- VNPay sandbox (Billing, used by the VNPay task) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# --- AI (ai.api) ---
AI_CONNECTION_STRING=
GEMINI_API_KEY=

# --- Shared by other services (owned by their developers; ask the team for the value) ---
ACADPREP_INTERNAL_API_KEY=
