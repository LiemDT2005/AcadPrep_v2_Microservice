# Build from the repository root; send only Notification and BuildingBlocks.Common/EventBus source.
**
!src/
!src/BuildingBlocks/
!src/BuildingBlocks/BuildingBlocks.Common/
!src/BuildingBlocks/BuildingBlocks.Common/**
!src/BuildingBlocks/BuildingBlocks.EventBus/
!src/BuildingBlocks/BuildingBlocks.EventBus/**
!src/Services/
!src/Services/Notification/
!src/Services/Notification/**
**/bin/
**/obj/
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/appsettings.Development.json
**/.env
**/.env.*
