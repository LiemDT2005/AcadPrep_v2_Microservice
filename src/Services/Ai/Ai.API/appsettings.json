{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=AcadPrep_AiServiceDb;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "ToeicLearning.Identity",
    "Audience": "ToeicLearning.Clients"
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/",
    "Model": "gemini-3.5-flash-lite",
    "MaxOutputTokens": 1024,
    "Temperature": 0.3,
    "TopP": 0.9,
    "TimeoutSeconds": 30,
    "MaxRetries": 2
  },
  "Tutor": {
    "ContextMessages": 10,
    "WindowHours": 24,
    "OutOfScopeMessage": "Mình chỉ hỗ trợ các câu hỏi về TOEIC và học tiếng Anh. Bạn thử hỏi về ngữ pháp, từ vựng hoặc cách làm một Part nhé!"
  },
  "Billing": {
    "BaseUrl": "http://localhost:5011/"
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*"
}
