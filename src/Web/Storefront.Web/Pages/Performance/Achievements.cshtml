@page
@model Storefront.Web.Pages.Performance.AchievementsModel
@{
    ViewData["Title"] = "Huy Hiệu & Chuỗi Ngày Học";
}

<div class="max-w-6xl mx-auto py-xl px-margin-mobile md:px-margin-desktop">
    <!-- Header -->
    <div class="mb-xl mb-6">
        <h2 class="font-headline-md text-headline-md text-on-surface mb-xs font-bold text-2xl">Huy Hiệu & Chuỗi Ngày Học</h2>
        <p class="font-body-md text-body-md text-on-surface-variant text-gray-600">Khám phá các danh hiệu và duy trì ngọn lửa học tập mỗi ngày trên AcadPrep!</p>
    </div>

    <!-- Study Streak Banner (UC-13.2) -->
    @if (Model.Streak != null)
    {
        <div class="bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded-2xl p-6 shadow-md mb-8 flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="flex items-center gap-5">
                <div class="w-16 h-16 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-4xl shadow-inner">
                    🔥
                </div>
                <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-orange-100">Gamification · Múi giờ UTC+7</span>
                    <h3 class="text-2xl font-extrabold flex items-center gap-2">
                        Chuỗi Ngày Học: @Model.Streak.CurrentStreak Ngày
                        @if (Model.Streak.IsActiveToday)
                        {
                            <span class="text-xs bg-green-500 text-white px-2 py-0.5 rounded-full font-bold">Đã học hôm nay</span>
                        }
                        else
                        {
                            <span class="text-xs bg-white/30 text-white px-2 py-0.5 rounded-full font-bold">Chưa học hôm nay</span>
                        }
                    </h3>
                    <p class="text-sm text-orange-100 mt-1">
                        Kỷ lục chuỗi dài nhất: <strong>@Model.Streak.MaxStreak ngày liên tục</strong>. Hãy làm đề hoặc ôn Flashcards trước 23:59:59 (giờ VN) để giữ chuỗi!
                    </p>
                </div>
            </div>
            <div class="flex gap-3">
                <a href="/Vocabulary/Review" class="bg-white text-orange-600 font-bold px-4 py-2 rounded-xl text-sm shadow hover:bg-orange-50 transition">
                    Ôn Flashcards ngay
                </a>
            </div>
        </div>
    }

    <!-- Achievements Grid (UC-13.1) -->
    <div class="mb-4 flex justify-between items-center">
        <h3 class="font-semibold text-lg text-gray-800">
            Danh Hiệu (@Model.Achievements.Count(a => a.IsUnlocked)/@Model.Achievements.Count đã mở khóa)
        </h3>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-lg gap-6">
        @foreach (var achievement in Model.Achievements)
        {
            var isUnlocked = achievement.IsUnlocked;
            var cardStyle = isUnlocked ? "bg-white border-primary shadow-sm hover:-translate-y-1" : "bg-gray-50 border-gray-200 opacity-75";
            var textStyle = isUnlocked ? "text-gray-900" : "text-gray-500";
            var iconOpacity = isUnlocked ? "" : "grayscale";
            var badgeBg = isUnlocked ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-500";

            <div class="rounded-xl border @cardStyle p-6 text-center flex flex-col transition-all duration-300">
                <div class="w-20 h-20 mx-auto rounded-full bg-gray-100 flex items-center justify-center mb-4 @iconOpacity">
                    @if (string.IsNullOrEmpty(achievement.IconUrl))
                    {
                        <span class="text-4xl">🏆</span>
                    }
                    else
                    {
                        <img src="@achievement.IconUrl" alt="@achievement.Name" class="w-12 h-12 object-contain" />
                    }
                </div>
                <h3 class="font-bold text-lg @textStyle mb-1">@achievement.Name</h3>
                <p class="text-xs text-gray-600 mb-4 flex-1">@achievement.Description</p>
                
                <div class="mt-auto pt-3 border-t border-gray-100">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold @badgeBg">
                        @if (isUnlocked)
                        {
                            <span class="material-symbols-outlined text-[14px] mr-1">check_circle</span>
                            @:Mở khóa: @achievement.UnlockedAt?.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span class="material-symbols-outlined text-[14px] mr-1">lock</span>
                            @:Chưa đạt (Yêu cầu: @achievement.ConditionType = @achievement.ConditionValue)
                        }
                    </span>
                </div>
            </div>
        }
    </div>
</div>
