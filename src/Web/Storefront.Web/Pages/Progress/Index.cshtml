@page
@model Storefront.Web.Pages.Progress.IndexModel
@{ ViewData["Title"] = "Progress"; }
<h1>Learning Progress</h1>
<p class="meta">Progress service · SQLite + Redis cache · Updated via RabbitMQ consumer.</p>
@if (string.IsNullOrEmpty(HttpContext.Session.GetString("jwt")))
{
    <div class="alert alert-error">Please <a asp-page="/Account/Login">login</a>.</div>
}
else if (Model.Summary is null)
{
    <div class="alert alert-error">No data available yet. Please complete a practice test first. If you just submitted, wait 1–2 seconds and refresh.</div>
}
else
{
    <div class="stats">
        <div class="stat"><span>Attempts</span><strong>@Model.Summary.TotalAttempts</strong></div>
        <div class="stat"><span>Avg Score</span><strong>@Model.Summary.AverageScore%</strong></div>
        <div class="stat"><span>Best Score</span><strong>@Model.Summary.BestScore%</strong></div>
    </div>
    <h2>Recent History</h2>
    @foreach (var r in Model.Summary.Recent)
    {
        <div class="card" style="margin-bottom:.75rem">
            <h3>@r.ExamTitle</h3>
            <p class="meta">@r.CompletedAt.ToLocalTime().ToString("g")</p>
            <p>Score: <strong>@r.Score%</strong> (@r.CorrectAnswers/@r.TotalQuestions correct)</p>
        </div>
    }
}
