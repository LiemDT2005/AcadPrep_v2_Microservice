@page "{id:guid}"
@model Storefront.Web.Pages.Exams.TakeModel
@{ ViewData["Title"] = Model.Exam?.Title ?? "Làm bài"; }
@if (Model.Exam is null)
{
    <div class="alert alert-error">Không tìm thấy đề.</div>
}
else if (Model.Result is not null)
{
    <div class="alert alert-ok">
        <h2>Hoàn thành: @Model.Result.ExamTitle</h2>
        <p>Điểm: <strong>@Model.Result.Score%</strong> (@Model.Result.CorrectAnswers/@Model.Result.TotalQuestions đúng)</p>
        <p>Event đã gửi tới Progress service. Xem <a asp-page="/Progress/Index">tiến độ</a>.</p>
    </div>
}
else
{
    <h1>@Model.Exam.Title</h1>
    <p class="meta">@Model.Exam.Part · @Model.Exam.TimeLimitMinutes phút</p>
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-error">@Model.Error</div>
    }
    <form method="post">
        @for (var i = 0; i < Model.Exam.Questions.Count; i++)
        {
            var q = Model.Exam.Questions[i];
            <div class="question">
                <h4>Câu @q.Order. @q.Stem</h4>
                <input type="hidden" name="Answers[@i].QuestionId" value="@q.Id" />
                <div class="options">
                    <label><input type="radio" name="Answers[@i].Answer" value="A" required /> A. @q.OptionA</label>
                    <label><input type="radio" name="Answers[@i].Answer" value="B" /> B. @q.OptionB</label>
                    <label><input type="radio" name="Answers[@i].Answer" value="C" /> C. @q.OptionC</label>
                    <label><input type="radio" name="Answers[@i].Answer" value="D" /> D. @q.OptionD</label>
                </div>
            </div>
        }
        <button class="btn" type="submit">Nộp bài</button>
    </form>
}
