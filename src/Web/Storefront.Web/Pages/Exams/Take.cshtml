@page "{id:int}"
@model Storefront.Web.Pages.Exams.TakeModel
@{
    Layout = null;
}
@if (Model.TestSession is not { Questions.Count: > 0 } session)
{
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Session unavailable | AcadPrep</title>
        <partial name="Shared/_ExamTestAssets" />
    </head>
    <body class="bg-surface font-body-md text-on-surface p-6">
        <div role="alert" class="rounded-2xl bg-error-container p-6 mb-4">Session unavailable. It may not exist, belong to another visitor, or the exam service may be offline.</div>
        <a asp-page="/Exams/Index" class="text-primary">Back to exam library</a>
    </body>
    </html>
}
else
{
    <partial name="@(session.Mode == "practice" ? "Shared/_PracticeSession" : "Shared/_FullTestSession")" model="session" />
}
