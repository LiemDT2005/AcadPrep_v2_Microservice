@page
@model Storefront.Web.Pages.Admin.Users.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Management";
    var users = Model.UserList?.Items ?? [];
    var totalCount = Model.UserList?.TotalCount ?? 0;
    var activeCount = users.Count(u => u.Status == "Active");
    var pendingCount = users.Count(u => u.Status == "PendingVerification");
    var bannedCount = users.Count(u => u.Status == "Banned");
}

<!-- ======================================================== -->
<!-- TOP HEADER & ACTION BUTTONS                              -->
<!-- ======================================================== -->
<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.75rem;">
    <div>
        <h1 style="font-size: 1.75rem; font-weight: 800; margin: 0 0 0.25rem; color: var(--admin-ink); letter-spacing: -0.02em;">
            Account Management & Access Control
        </h1>
        <p style="margin: 0; color: var(--admin-muted); font-size: 0.95rem;">
            Role-based access control (Admin · Moderator · Learner) & status management
        </p>
    </div>

    <div style="display: flex; gap: 0.75rem;">
        <a asp-page-handler="ExportCsv" class="btn btn-outline" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.1rem; font-size: 0.9rem; font-weight: 600; border-radius: 8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Export CSV
        </a>
        <button type="button" class="btn" onclick="openProfileModal()" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.1rem; font-size: 0.9rem; background: var(--admin-primary); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
            Admin Profile
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success" style="background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; padding: 0.85rem 1.25rem; border-radius: 10px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.65rem; font-size: 0.95rem; box-shadow: 0 2px 6px rgba(16,185,129,0.08);">
        <span style="font-size: 1.1rem; font-weight: bold;">✓</span>
        <strong>@Model.SuccessMessage</strong>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-error" style="background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; padding: 0.85rem 1.25rem; border-radius: 10px; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.65rem; font-size: 0.95rem; box-shadow: 0 2px 6px rgba(239,68,68,0.08);">
        <span style="font-size: 1.1rem; font-weight: bold;">✕</span>
        <strong>@Model.ErrorMessage</strong>
    </div>
}

<!-- ======================================================== -->
<!-- STATS METRICS OVERVIEW CARDS                             -->
<!-- ======================================================== -->
<div id="statsOverview" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 1.75rem;">
    <div style="background: white; border-radius: 14px; padding: 1.25rem 1.5rem; border: 1px solid var(--admin-border); box-shadow: var(--admin-shadow); display: flex; justify-content: space-between; align-items: center;">
        <div>
            <span style="font-size: 0.82rem; font-weight: 600; color: var(--admin-muted); text-transform: uppercase; letter-spacing: 0.05em;">Total Accounts</span>
            <div style="font-size: 1.85rem; font-weight: 800; color: var(--admin-ink); margin-top: 0.2rem;">@totalCount</div>
        </div>
        <div style="width: 48px; height: 48px; border-radius: 12px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
        </div>
    </div>

    <div style="background: white; border-radius: 14px; padding: 1.25rem 1.5rem; border: 1px solid var(--admin-border); box-shadow: var(--admin-shadow); display: flex; justify-content: space-between; align-items: center;">
        <div>
            <span style="font-size: 0.82rem; font-weight: 600; color: var(--admin-muted); text-transform: uppercase; letter-spacing: 0.05em;">Active (Page)</span>
            <div style="font-size: 1.85rem; font-weight: 800; color: #166534; margin-top: 0.2rem;">@activeCount</div>
        </div>
        <div style="width: 48px; height: 48px; border-radius: 12px; background: #dcfce7; color: #166534; display: flex; align-items: center; justify-content: center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
            </svg>
        </div>
    </div>

    <div style="background: white; border-radius: 14px; padding: 1.25rem 1.5rem; border: 1px solid var(--admin-border); box-shadow: var(--admin-shadow); display: flex; justify-content: space-between; align-items: center;">
        <div>
            <span style="font-size: 0.82rem; font-weight: 600; color: var(--admin-muted); text-transform: uppercase; letter-spacing: 0.05em;">Pending OTP</span>
            <div style="font-size: 1.85rem; font-weight: 800; color: #854d0e; margin-top: 0.2rem;">@pendingCount</div>
        </div>
        <div style="width: 48px; height: 48px; border-radius: 12px; background: #fef9c3; color: #854d0e; display: flex; align-items: center; justify-content: center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
        </div>
    </div>

    <div style="background: white; border-radius: 14px; padding: 1.25rem 1.5rem; border: 1px solid var(--admin-border); box-shadow: var(--admin-shadow); display: flex; justify-content: space-between; align-items: center;">
        <div>
            <span style="font-size: 0.82rem; font-weight: 600; color: var(--admin-muted); text-transform: uppercase; letter-spacing: 0.05em;">Banned Accounts</span>
            <div style="font-size: 1.85rem; font-weight: 800; color: #991b1b; margin-top: 0.2rem;">@bannedCount</div>
        </div>
        <div style="width: 48px; height: 48px; border-radius: 12px; background: #fee2e2; color: #991b1b; display: flex; align-items: center; justify-content: center;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
            </svg>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- FILTER & SEARCH BAR                                      -->
<!-- ======================================================== -->
<div style="background: white; padding: 1.25rem 1.5rem; border-radius: 14px; border: 1px solid var(--admin-border); box-shadow: var(--admin-shadow); margin-bottom: 1.5rem;">
    <form method="get" style="display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end;">
        <div style="flex: 1; min-width: 240px;">
            <label style="display: block; font-size: 0.82rem; font-weight: 600; color: #475569; margin-bottom: 0.35rem;">Search by Name or Email</label>
            <input type="text" asp-for="Search" placeholder="Enter user name or email..." style="width: 100%; padding: 0.65rem 0.9rem; border: 1.5px solid var(--admin-border); border-radius: 8px; font-size: 0.92rem; outline: none;" />
        </div>

        <div style="width: 180px;">
            <label style="display: block; font-size: 0.82rem; font-weight: 600; color: #475569; margin-bottom: 0.35rem;">Filter by Role</label>
            <select asp-for="Role" style="width: 100%; padding: 0.65rem 0.9rem; border: 1.5px solid var(--admin-border); border-radius: 8px; font-size: 0.92rem; background: white;">
                <option value="">-- All Roles --</option>
                <option value="Admin">Admin</option>
                <option value="Moderator">Moderator</option>
                <option value="Learner">Learner</option>
            </select>
        </div>

        <div style="width: 200px;">
            <label style="display: block; font-size: 0.82rem; font-weight: 600; color: #475569; margin-bottom: 0.35rem;">Filter by Status</label>
            <select asp-for="Status" style="width: 100%; padding: 0.65rem 0.9rem; border: 1.5px solid var(--admin-border); border-radius: 8px; font-size: 0.92rem; background: white;">
                <option value="">-- All Statuses --</option>
                <option value="Active">Active</option>
                <option value="PendingVerification">Pending OTP</option>
                <option value="Banned">Banned</option>
            </select>
        </div>

        <div style="display: flex; gap: 0.5rem;">
            <button type="submit" class="btn" style="padding: 0.65rem 1.25rem; font-size: 0.92rem; background: var(--admin-primary); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                Filter
            </button>
            <a asp-page="/Admin/Users/Index" class="btn btn-outline" style="padding: 0.65rem 1rem; font-size: 0.92rem; border: 1.5px solid var(--admin-border); color: #64748b; border-radius: 8px; text-decoration: none;">
                Reset
            </a>
        </div>
    </form>
</div>

<!-- ======================================================== -->
<!-- USERS DATA TABLE                                         -->
<!-- ======================================================== -->
<div style="background: white; border-radius: 14px; border: 1px solid var(--admin-border); box-shadow: var(--admin-shadow); overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.92rem;">
        <thead>
            <tr style="background: #f8fafc; border-bottom: 2px solid var(--admin-border); color: #475569; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">
                <th style="padding: 1rem 1.25rem;">User / Learner</th>
                <th style="padding: 1rem 1.25rem;">Email & Source</th>
                <th style="padding: 1rem 1.25rem;">Roles (RBAC)</th>
                <th style="padding: 1rem 1.25rem;">Status</th>
                <th style="padding: 1rem 1.25rem;">Created / Last Login</th>
                <th style="padding: 1rem 1.25rem; text-align: center;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (users.Count == 0)
            {
                <tr>
                    <td colspan="6" style="padding: 3.5rem 1rem; text-align: center; color: var(--admin-muted);">
                        <strong style="font-size: 1.1rem; color: var(--admin-ink); display: block; margin-bottom: 0.25rem;">No users found</strong>
                        <p style="margin: 0; font-size: 0.9rem;">Try adjusting your search keywords or status filter above.</p>
                    </td>
                </tr>
            }
            else
            {
                foreach (var u in users)
                {
                    <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.15s ease;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='white'">
                        <td style="padding: 0.9rem 1.25rem;">
                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                                @if (!string.IsNullOrEmpty(u.Avatar))
                                {
                                    <img src="@u.Avatar" alt="@u.FullName" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 1.5px solid #cbd5e1;" />
                                }
                                else
                                {
                                    <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1rem;">
                                        @(string.IsNullOrWhiteSpace(u.FullName) ? "U" : u.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                                <div>
                                    <strong style="color: var(--admin-ink); font-size: 0.95rem; display: block;">@u.FullName</strong>
                                    <span style="font-family: monospace; font-size: 0.75rem; color: #94a3b8;">ID: @(u.Id.Length > 10 ? u.Id.Substring(0, 10) + "..." : u.Id)</span>
                                </div>
                            </div>
                        </td>

                        <td style="padding: 0.9rem 1.25rem;">
                            <div style="color: var(--admin-ink); font-weight: 500;">@u.Email</div>
                            <span class="badge" style="background: #f1f5f9; color: #475569; font-size: 0.72rem; margin-top: 0.25rem;">
                                Source: @u.AuthProvider
                            </span>
                        </td>

                        <td style="padding: 0.9rem 1.25rem;">
                            <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
                                @foreach (var r in u.Roles)
                                {
                                    var badgeBg = r == "Admin" ? "#fee2e2" : r == "Moderator" ? "#e0e7ff" : "#dcfce7";
                                    var badgeColor = r == "Admin" ? "#991b1b" : r == "Moderator" ? "#3730a3" : "#166534";
                                    <span class="badge" style="background: @badgeBg; color: @badgeColor; font-size: 0.78rem; font-weight: 700; padding: 0.2rem 0.55rem; border-radius: 6px;">
                                        @r
                                    </span>
                                }
                            </div>
                        </td>

                        <td style="padding: 0.9rem 1.25rem;">
                            @if (u.Status == "Active")
                            {
                                <span class="badge" style="background: #dcfce7; color: #166534; font-size: 0.8rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 999px;">
                                    Active
                                </span>
                            }
                            else if (u.Status == "PendingVerification")
                            {
                                <span class="badge" style="background: #fef9c3; color: #854d0e; font-size: 0.8rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 999px;">
                                    Pending OTP
                                </span>
                            }
                            else
                            {
                                <span class="badge" style="background: #fee2e2; color: #991b1b; font-size: 0.8rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 999px;">
                                    Banned
                                </span>
                            }
                        </td>

                        <td style="padding: 0.9rem 1.25rem; font-size: 0.82rem; color: var(--admin-muted);">
                            <div>Created: <strong>@u.CreatedAt.ToString("MM/dd/yyyy HH:mm")</strong></div>
                            <div>Login: <strong>@(u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToString("MM/dd/yyyy HH:mm") : "Never")</strong></div>
                        </td>

                        <td style="padding: 0.9rem 1.25rem; text-align: center;">
                            <div style="display: flex; gap: 0.4rem; justify-content: center; align-items: center;">
                                <button type="button" class="btn btn-outline" style="font-size: 0.8rem; padding: 0.35rem 0.7rem; border-radius: 6px;" onclick="viewDetail('@u.Id')" title="View account details & sessions">
                                    Details
                                </button>
                                <button type="button" class="btn" style="font-size: 0.8rem; padding: 0.35rem 0.7rem; background: #0f172a; color: white; border: none; border-radius: 6px;" onclick="openRoleModal('@u.Id', '@u.FullName', '@string.Join(",", u.Roles)')" title="Assign roles">
                                    Roles
                                </button>
                                @if (u.Status == "Banned")
                                {
                                    <form method="post" asp-page-handler="UpdateStatus" style="display: inline;" onsubmit="return confirm('Are you sure you want to unban this account?');">
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <input type="hidden" name="targetStatus" value="1" />
                                        <button type="submit" class="btn" style="font-size: 0.8rem; padding: 0.35rem 0.7rem; background: #166534; color: white; border: none; border-radius: 6px; cursor: pointer;">
                                            Unban
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn" style="font-size: 0.8rem; padding: 0.35rem 0.7rem; background: #dc2626; color: white; border: none; border-radius: 6px; cursor: pointer;" onclick="openBanModal('@u.Id', '@u.FullName')">
                                        Ban
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- ======================================================== -->
<!-- PAGINATION                                               -->
<!-- ======================================================== -->
@if (Model.UserList is not null && Model.UserList.TotalPages > 1)
{
    <div style="display: flex; justify-content: center; align-items: center; gap: 0.5rem; margin-top: 1.75rem;">
        @if (Model.UserList.PageIndex > 1)
        {
            <a asp-page="/Admin/Users/Index" asp-route-pageIndex="@(Model.UserList.PageIndex - 1)" asp-route-search="@Model.Search" asp-route-role="@Model.Role" asp-route-status="@Model.Status" class="btn btn-outline" style="padding: 0.45rem 0.9rem; font-size: 0.88rem; border-radius: 8px;">
                ← Previous
            </a>
        }

        <span style="font-size: 0.9rem; color: var(--admin-muted); padding: 0 0.75rem;">
            Page <strong style="color: var(--admin-ink);">@Model.UserList.PageIndex</strong> of <strong>@Model.UserList.TotalPages</strong>
        </span>

        @if (Model.UserList.PageIndex < Model.UserList.TotalPages)
        {
            <a asp-page="/Admin/Users/Index" asp-route-pageIndex="@(Model.UserList.PageIndex + 1)" asp-route-search="@Model.Search" asp-route-role="@Model.Role" asp-route-status="@Model.Status" class="btn btn-outline" style="padding: 0.45rem 0.9rem; font-size: 0.88rem; border-radius: 8px;">
                Next →
            </a>
        }
    </div>
}

<!-- ======================================================== -->
<!-- MODAL: ACCOUNT DETAILS                                   -->
<!-- ======================================================== -->
<div id="detailModal" class="modal-backdrop" onclick="handleBackdropClick(event, 'detailModal')">
    <div class="modal-box" style="max-width: 640px;">
        <div class="modal-header">
            <h3 class="modal-title">Learner Account Details</h3>
            <button type="button" class="modal-close-btn" onclick="closeDetailModal()">✕</button>
        </div>

        <div class="modal-body" id="detailContent">
            <p style="text-align: center; color: var(--admin-muted); padding: 2rem 0;">Loading details...</p>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-outline" onclick="closeDetailModal()">Close</button>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL: ASSIGN ROLES (RBAC)                               -->
<!-- ======================================================== -->
<div id="roleModal" class="modal-backdrop" onclick="handleBackdropClick(event, 'roleModal')">
    <div class="modal-box" style="max-width: 480px;">
        <div class="modal-header">
            <h3 class="modal-title">Role Assignment (RBAC)</h3>
            <button type="button" class="modal-close-btn" onclick="closeRoleModal()">✕</button>
        </div>

        <form method="post" asp-page-handler="AssignRoles">
            <div class="modal-body">
                <p style="color: var(--admin-muted); font-size: 0.9rem; margin: 0 0 1.25rem;">
                    Update roles for user: <strong id="modalUserName" style="color: var(--admin-ink);"></strong>
                </p>

                <input type="hidden" name="userId" id="modalUserId" />

                <div style="background: #f8fafc; padding: 1.1rem; border-radius: 10px; border: 1px solid var(--admin-border); margin-bottom: 1.25rem;">
                    <label style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.85rem; cursor: pointer;">
                        <input type="checkbox" name="selectedRoles" value="Admin" id="roleAdmin" style="width: 18px; height: 18px;" />
                        <div>
                            <strong style="color: #991b1b; display: block;">Admin (Full System Administrator)</strong>
                            <div style="font-size: 0.78rem; color: #64748b;">Full control over user accounts, reports, and system settings.</div>
                        </div>
                    </label>

                    <label style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.85rem; cursor: pointer;">
                        <input type="checkbox" name="selectedRoles" value="Moderator" id="roleModerator" style="width: 18px; height: 18px;" />
                        <div>
                            <strong style="color: #3730a3; display: block;">Moderator (CMS Content Manager)</strong>
                            <div style="font-size: 0.78rem; color: #64748b;">Manage question banks, reading passages, and exams.</div>
                        </div>
                    </label>

                    <label style="display: flex; align-items: center; gap: 0.75rem; cursor: pointer;">
                        <input type="checkbox" name="selectedRoles" value="Learner" id="roleLearner" style="width: 18px; height: 18px;" />
                        <div>
                            <strong style="color: #065f46; display: block;">Learner (Student)</strong>
                            <div style="font-size: 0.78rem; color: #64748b;">Take practice exams, review flashcards, and track progress.</div>
                        </div>
                    </label>
                </div>

                <div style="font-size: 0.78rem; color: #ea580c; background: #fff7ed; padding: 0.75rem; border-radius: 8px; border: 1px solid #fed7aa;">
                    <strong>Security Notice:</strong> Cannot revoke Admin role from the Master Admin (admin@acadprep.com) or from your own account.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" onclick="closeRoleModal()" class="btn btn-outline">Cancel</button>
                <button type="submit" class="btn" style="background: var(--admin-primary); color: white; border: none; font-weight: 600;">
                    Save Roles
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL: BAN USER ACCOUNT                                  -->
<!-- ======================================================== -->
<div id="banModal" class="modal-backdrop" onclick="handleBackdropClick(event, 'banModal')">
    <div class="modal-box" style="max-width: 500px;">
        <div class="modal-header">
            <h3 class="modal-title" style="color: #dc2626;">Ban User Account</h3>
            <button type="button" class="modal-close-btn" onclick="closeBanModal()">✕</button>
        </div>

        <form method="post" asp-page-handler="UpdateStatus">
            <div class="modal-body">
                <p style="color: var(--admin-muted); font-size: 0.9rem; margin: 0 0 1.25rem;">
                    Ban learner account: <strong id="banModalUserName" style="color: var(--admin-ink);"></strong>
                </p>

                <input type="hidden" name="userId" id="banModalUserId" />
                <input type="hidden" name="targetStatus" value="2" />

                <div style="margin-bottom: 1.25rem;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 600; color: #475569; margin-bottom: 0.4rem;">
                        Reason for banning <span style="color: #dc2626;">*</span>
                    </label>
                    <textarea name="banReason" rows="3" required placeholder="Enter reason for banning (terms violation, suspicious behavior...)" style="width: 100%; padding: 0.65rem 0.85rem; border: 1.5px solid var(--admin-border); border-radius: 8px; font-size: 0.92rem; font-family: inherit; resize: vertical;"></textarea>
                </div>

                <div style="font-size: 0.78rem; color: #b91c1c; background: #fef2f2; padding: 0.75rem; border-radius: 8px; border: 1px solid #fecaca;">
                    <strong>Immediate Action:</strong> All Refresh Tokens will be revoked and a real-time SignalR Force Logout signal will terminate active sessions immediately.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" onclick="closeBanModal()" class="btn btn-outline">Cancel</button>
                <button type="submit" class="btn" style="background: #dc2626; color: white; border: none; font-weight: 600;">
                    Confirm Ban
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        async function viewDetail(userId) {
            const modal = document.getElementById('detailModal');
            const content = document.getElementById('detailContent');
            if (!modal || !content) return;

            modal.classList.add('show');
            content.innerHTML = '<p style="text-align: center; color: #94a3b8; padding: 2.5rem 0;">Loading details...</p>';

            try {
                const res = await fetch(`?handler=DetailJson&id=${userId}`);
                if (!res.ok) throw new Error("Unable to load details");
                const u = await res.json();

                let sessionsHtml = '<p style="color: #94a3b8; font-size: 0.85rem;">No recent login sessions.</p>';
                if (u.recentSessions && u.recentSessions.length > 0) {
                    sessionsHtml = `
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem; margin-top: 0.5rem;">
                            <thead>
                                <tr style="background: #f1f5f9; color: #475569;">
                                    <th style="padding: 0.45rem; text-align: left;">Token Preview</th>
                                    <th style="padding: 0.45rem; text-align: left;">Created IP</th>
                                    <th style="padding: 0.45rem; text-align: left;">Timestamp</th>
                                    <th style="padding: 0.45rem; text-align: center;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${u.recentSessions.map(s => `
                                    <tr style="border-bottom: 1px solid #f1f5f9;">
                                        <td style="padding: 0.45rem; font-family: monospace;">${s.tokenPreview}</td>
                                        <td style="padding: 0.45rem;">${s.createdByIp || 'N/A'}</td>
                                        <td style="padding: 0.45rem;">${new Date(s.createdAt).toLocaleString()}</td>
                                        <td style="padding: 0.45rem; text-align: center;">
                                            ${s.isActive ? '<span style="color: #166534; font-weight: 700;">Active</span>' : '<span style="color: #94a3b8;">Revoked</span>'}
                                        </td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    `;
                }

                content.innerHTML = `
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; font-size: 0.88rem; background: #f8fafc; padding: 1.1rem; border-radius: 10px; border: 1px solid var(--admin-border);">
                        <div><span style="color: var(--admin-muted);">Full Name:</span> <strong style="color: var(--admin-ink);">${u.fullName}</strong></div>
                        <div><span style="color: var(--admin-muted);">Email:</span> <strong>${u.email}</strong></div>
                        <div><span style="color: var(--admin-muted);">Auth Provider:</span> <strong>${u.authProvider}</strong></div>
                        <div><span style="color: var(--admin-muted);">Status:</span> <strong style="color: ${u.status === 'Active' ? '#166534' : '#991b1b'};">${u.status}</strong></div>
                        <div><span style="color: var(--admin-muted);">Email Verified:</span> <strong>${u.emailConfirmed ? '✓ Verified' : '✕ Unverified'}</strong></div>
                        <div><span style="color: var(--admin-muted);">Failed Attempts:</span> <strong>${u.accessFailedCount} times</strong></div>
                        <div><span style="color: var(--admin-muted);">Created At:</span> <strong>${new Date(u.createdAt).toLocaleString()}</strong></div>
                        <div><span style="color: var(--admin-muted);">Last Login:</span> <strong>${u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleString() : 'Never'}</strong></div>
                    </div>

                    <div style="margin-top: 1.25rem;">
                        <h4 style="margin: 0 0 0.4rem; font-size: 0.95rem; color: var(--admin-ink);">Assigned Roles:</h4>
                        <div style="display: flex; gap: 0.4rem;">
                            ${u.roles.map(r => `<span class="badge" style="background: #e0e7ff; color: #3730a3; padding: 0.25rem 0.65rem; border-radius: 6px; font-size: 0.78rem; font-weight: 700;">${r}</span>`).join('')}
                        </div>
                    </div>

                    <div style="margin-top: 1.25rem;">
                        <h4 style="margin: 0 0 0.4rem; font-size: 0.95rem; color: var(--admin-ink);">Login Session History (Refresh Tokens):</h4>
                        ${sessionsHtml}
                    </div>
                `;
            } catch (err) {
                content.innerHTML = `<p style="color: #b91c1c; text-align: center; padding: 1.5rem 0;">Error loading details: ${err.message}</p>`;
            }
        }

        function closeDetailModal() {
            document.getElementById('detailModal')?.classList.remove('show');
        }

        function openRoleModal(userId, userName, currentRolesStr) {
            document.getElementById('modalUserId').value = userId;
            document.getElementById('modalUserName').textContent = userName;

            const currentRoles = currentRolesStr ? currentRolesStr.split(',') : [];
            document.getElementById('roleAdmin').checked = currentRoles.includes('Admin');
            document.getElementById('roleModerator').checked = currentRoles.includes('Moderator');
            document.getElementById('roleLearner').checked = currentRoles.includes('Learner');

            document.getElementById('roleModal')?.classList.add('show');
        }

        function closeRoleModal() {
            document.getElementById('roleModal')?.classList.remove('show');
        }

        function openBanModal(userId, userName) {
            document.getElementById('banModalUserId').value = userId;
            document.getElementById('banModalUserName').textContent = userName;
            document.getElementById('banModal')?.classList.add('show');
        }

        function closeBanModal() {
            document.getElementById('banModal')?.classList.remove('show');
        }
    </script>
}
