@model Storefront.Web.Pages.Admin.Exams.IndexModel

<div id="create-exam-modal" class="@(Model.ShowCreateModal ? "" : "hidden") fixed inset-0 z-50 flex items-center justify-center p-md bg-on-surface/60 backdrop-blur-sm @(Model.ShowCreateModal ? "opacity-100" : "opacity-0 pointer-events-none") transition-opacity duration-300">
    <div id="create-exam-modal-content" class="bg-surface-container-lowest w-full max-w-2xl md:max-w-3xl rounded-xl shadow-2xl overflow-hidden transform @(Model.ShowCreateModal ? "scale-100 opacity-100" : "scale-95 opacity-0") transition-all duration-300">
        <div class="flex justify-between items-center px-lg py-md border-b border-outline-variant">
            <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold">Create New Exam</h2>
            <button type="button" onclick="closeCreateExamModal()" class="p-xs hover:bg-surface-variant rounded-full transition-colors text-on-surface-variant cursor-pointer active:scale-95">
                <span class="material-symbols-outlined text-[24px]">close</span>
            </button>
        </div>

        @if (Model.CreateExamErrors.Any())
        {
            <div class="mx-lg mt-md bg-error-container text-on-error-container p-md rounded-xl border border-error/20 flex flex-col gap-xs">
                <div class="flex items-center gap-xs font-semibold">
                    <span class="material-symbols-outlined text-error">error</span>
                    <ul class="list-disc pl-lg font-body-sm text-body-sm">
                        @foreach (var error in Model.CreateExamErrors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            </div>
        }

        <form method="post" asp-page-handler="Create" enctype="multipart/form-data" id="create-exam-form" class="p-lg space-y-lg">
            <div class="space-y-xs">
                <label class="flex items-center gap-xs font-label-md text-label-md text-on-surface-variant" asp-for="CreateExamForm.Title">
                    Exam Title
                    <span class="text-error font-bold">*</span>
                </label>
                <input asp-for="CreateExamForm.Title" required class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-md py-sm font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary transition-all placeholder:text-outline" placeholder="e.g., ETS TOEIC 2026 Test 1" />
            </div>

            <div class="space-y-xs">
                <label class="font-label-md text-label-md text-on-surface-variant" asp-for="CreateExamForm.Description">
                    Description (Optional)
                </label>
                <textarea asp-for="CreateExamForm.Description" class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-md py-sm font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary-container focus:border-primary transition-all placeholder:text-outline resize-none" placeholder="Brief description of this exam..." rows="3"></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-md">
                <div class="space-y-xs md:col-span-5">
                    <label class="flex items-center gap-xs font-label-md text-label-md text-on-surface-variant" asp-for="CreateExamForm.ExamType">
                        Part / Test type
                        <span class="text-error font-bold">*</span>
                    </label>
                    <div class="relative">
                        <select asp-for="CreateExamForm.ExamType" required class="w-full appearance-none bg-surface-container-lowest border border-outline-variant rounded-lg pl-md pr-10 py-sm font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all cursor-pointer">
                            <option value="Full Test">Full Test (Part 1-7)</option>
                            <option value="Part 1">Part 1: Photographs</option>
                            <option value="Part 2">Part 2: Question-Response</option>
                            <option value="Part 3">Part 3: Conversations</option>
                            <option value="Part 4">Part 4: Talks</option>
                            <option value="Part 5">Part 5: Incomplete Sentences</option>
                            <option value="Part 6">Part 6: Text Completion</option>
                            <option value="Part 7">Part 7: Reading Comprehension</option>
                            <option value="Reading">Reading (Mini Test)</option>
                            <option value="Listening">Listening (Mini Test)</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 flex items-center pr-sm pointer-events-none">
                            <span class="material-symbols-outlined text-on-surface-variant">expand_more</span>
                        </div>
                    </div>
                </div>

                <div class="space-y-xs md:col-span-3">
                    <label class="flex items-center gap-xs font-label-md text-label-md text-on-surface-variant" asp-for="CreateExamForm.Duration">
                        Duration (minutes)
                        <span class="text-error font-bold">*</span>
                    </label>
                    <div class="relative">
                        <input asp-for="CreateExamForm.Duration" class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg pl-md pr-14 py-sm font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all" type="number" min="1" max="240" />
                        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                            <span class="text-xs text-outline">minutes</span>
                        </div>
                    </div>
                </div>

                <div class="space-y-xs md:col-span-4">
                    <label class="flex items-center gap-xs font-label-md text-label-md text-on-surface-variant" asp-for="CreateExamForm.ExamSeriesId">
                        Test series
                        <span class="text-error font-bold">*</span>
                    </label>
                    <div class="relative">
                        <select asp-for="CreateExamForm.ExamSeriesId" required class="w-full appearance-none bg-surface-container-lowest border border-outline-variant rounded-lg pl-md pr-10 py-sm font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all cursor-pointer">
                            <option value="">-- Select Test Series --</option>
                            @{
                                var years = new int[] { 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026 };
                            }
                            @foreach (var yr in years)
                            {
                                var matched = Model.ExamSeries.FirstOrDefault(s => s.Year == yr && s.Name.Contains("ETS"));
                                var seriesId = matched?.Id ?? (yr switch {
                                    2018 => 1010,
                                    2019 => 1011,
                                    2020 => 1012,
                                    2021 => 1013,
                                    2022 => 1014,
                                    2023 => 1015,
                                    2024 => 1,
                                    2025 => 1016,
                                    2026 => 1017,
                                    _ => 1
                                });
                                <option value="@seriesId">EST TOEIC @yr</option>
                            }
                        </select>
                        <div class="absolute inset-y-0 right-0 flex items-center pr-sm pointer-events-none">
                            <span class="material-symbols-outlined text-on-surface-variant">expand_more</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="space-y-xs p-md rounded-xl bg-surface-container-low/60 border border-outline-variant/30">
                <label class="font-label-md text-label-md text-on-surface-variant flex items-center gap-xs" asp-for="CreateExamForm.AudioFile">
                    <span class="material-symbols-outlined text-primary text-sm">cloud_upload</span>
                    Upload Full Exam Audio to Cloudinary (.mp3, .wav, .m4a)
                </label>
                <input type="file" asp-for="CreateExamForm.AudioFile" accept="audio/*" class="w-full text-xs text-on-surface-variant file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20 cursor-pointer" />
            </div>

            <div class="px-0 py-0 bg-transparent flex items-center justify-between border-t border-outline-variant/30 pt-lg">
                <button type="button" onclick="closeCreateExamModal()" class="px-lg py-md border border-outline rounded-lg font-label-md text-label-md text-on-surface-variant hover:bg-surface-container-high transition-all active:scale-95 cursor-pointer">
                    Cancel
                </button>
                <button type="submit" id="btn-submit-create-exam" class="bg-primary hover:bg-primary/90 text-on-primary font-label-md text-label-md py-md px-xl rounded-lg flex items-center gap-xs transition-all shadow-md active:scale-95 cursor-pointer">
                    <span class="material-symbols-outlined text-sm">add</span>
                    <span>Create Exam</span>
                </button>
            </div>
        </form>
    </div>
</div>
