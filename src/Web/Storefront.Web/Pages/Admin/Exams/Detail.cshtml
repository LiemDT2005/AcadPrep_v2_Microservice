@page
@model Storefront.Web.Pages.Admin.Exams.DetailModel
@{
    Layout = "_ModeratorLayout";
    ViewData["Title"] = "Exam Details - " + Model.Exam.Title;

    var structure = Storefront.Web.Pages.Admin.Exams.ExamStructureViewModel.From(Model.Exam, isReadOnly: true);

    var hero = new Storefront.Web.Pages.Admin.Exams.ExamPageHeroViewModel
    {
        Exam = Model.Exam,
        TotalQuestions = structure.TotalQuestions,
        IsReadOnly = true,
        BreadcrumbCurrent = "Exam Details",
        HeroIcon = "info"
    };
}

<link rel="stylesheet" href="~/css/admin-question-create.css" />

@Html.AntiForgeryToken()

<div class="w-full flex flex-col gap-lg pb-12">
    <partial name="_ExamPageHero" model="hero" />
    <partial name="_ExamStatsPanel" model="structure" />
    <partial name="_ExamStructureProgress" model="structure" />
    <partial name="_ExamQuestionTree" model="structure" />

    @if (!Model.Exam.IsDeleted && Model.Exam.Status != "Hidden")
    {
        <div class="flex justify-end gap-sm mt-4">
            @if (Model.Exam.Status == "Published")
            {
                <button type="button"
                        data-exam-id="@Model.Exam.Id"
                        data-exam-title="@Model.Exam.Title"
                        onclick="confirmChangeStatus(@Model.Exam.Id, '@Model.Exam.Title', 'Draft')"
                        class="bg-secondary-container hover:bg-secondary-container/80 text-on-secondary-container font-label-md text-label-md py-2 px-4 rounded-lg flex items-center gap-xs transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-sm">edit_note</span>
                    Unpublish (to Draft)
                </button>
            }
            else
            {
                <button type="button"
                        data-exam-id="@Model.Exam.Id"
                        data-exam-title="@Model.Exam.Title"
                        onclick="confirmChangeStatus(@Model.Exam.Id, '@Model.Exam.Title', 'Published')"
                        class="bg-primary hover:bg-primary/90 text-on-primary font-label-md text-label-md py-2 px-4 rounded-lg flex items-center gap-xs transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-sm">publish</span>
                    Publish Exam
                </button>
            }
            <button type="button"
                    data-exam-id="@Model.Exam.Id"
                    data-exam-title="@Model.Exam.Title"
                    onclick="confirmSoftDelete(@Model.Exam.Id, '@Model.Exam.Title')"
                    class="bg-error-container hover:bg-error-container/80 text-on-error-container font-label-md text-label-md py-2 px-4 rounded-lg flex items-center gap-xs transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-sm">visibility_off</span>
                Hide / Delete Exam
            </button>
        </div>
    }
</div>

@section Scripts {
<script>
    function confirmChangeStatus(id, title, newStatus) {
        const publishing = newStatus === 'Published';
        showConfirm({
            title: publishing ? 'Publish Exam' : 'Unpublish Exam',
            message: publishing
                ? `Publish the exam "${title}"? Students will be able to see and take it.`
                : `Move the exam "${title}" back to Draft? Students will no longer see it in the active list.`,
            confirmText: publishing ? 'Publish' : 'Unpublish',
            isDestructive: !publishing,
            onConfirm: async () => {
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    const response = await fetch(`/Admin/Exams/Detail?handler=Status&id=${id}&status=${newStatus}`, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token }
                    });

                    if (response.ok) {
                        const data = await response.json();
                        if (data.success) {
                            showToast(publishing ? 'Exam published successfully!' : 'Exam moved to draft.', 'success');
                            setTimeout(() => window.location.reload(), 1000);
                        } else {
                            showToast(data.error || 'Failed to change exam status.', 'error');
                        }
                    } else {
                        showToast('Failed to change status.', 'error');
                    }
                } catch (err) {
                    console.error(err);
                    showToast('Could not connect to the server.', 'error');
                }
            }
        });
    }

    function confirmSoftDelete(id, title) {
        showConfirm({
            title: 'Hide / Delete Exam',
            message: `Are you sure you want to hide/delete the exam "${title}"? If students have attempts, it will be soft-deleted.`,
            confirmText: 'Confirm',
            isDestructive: true,
            onConfirm: async () => {
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    const response = await fetch(`/Admin/Exams/Detail?handler=Delete&id=${id}`, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token }
                    });

                    if (response.ok) {
                        const data = await response.json();
                        if (data.success) {
                            showToast('Exam deleted/hidden successfully!', 'success');
                            setTimeout(() => {
                                window.location.href = '/Admin/Exams';
                            }, 1000);
                        } else {
                            showToast(data.error || 'Failed to hide/delete the exam.', 'error');
                        }
                    } else {
                        showToast('Failed to delete/hide the exam.', 'error');
                    }
                } catch (err) {
                    console.error(err);
                    showToast('Could not connect to the server.', 'error');
                }
            }
        });
    }
</script>
}
