@model Storefront.Web.Pages.Admin.Exams.ExamStructureViewModel
@{
    var exam = Model.Exam;
    var isExamActive = !exam.IsDeleted && exam.Status == "Published";
}

<!-- Delete Content Confirmation Modal (with Active Exam Warning) -->
<div id="deleteConfirmModal" class="qc-modal hidden">
    <div class="qc-modal__backdrop" onclick="closeDeleteModal()"></div>
    <div class="qc-modal__panel">
        <div class="flex items-start gap-md">
            <div class="w-12 h-12 rounded-full bg-error-container text-on-error-container flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-error">warning</span>
            </div>
            <div class="flex-1">
                <h4 class="font-title-lg text-title-lg font-bold text-on-surface">Confirm Delete</h4>
                <p class="font-body-md text-body-md text-on-surface-variant mt-xs">
                    Are you sure you want to permanently delete <strong id="deleteTargetName" class="text-on-surface">this item</strong>?
                </p>

                @if (isExamActive)
                {
                    <div class="mt-md p-3 rounded-xl bg-error-container/40 border border-error/40 text-on-error-container flex items-start gap-xs">
                        <span class="material-symbols-outlined text-error text-base mt-0.5">report</span>
                        <div class="text-xs leading-relaxed">
                            <strong>Warning (Active Exam):</strong> This question belongs to <strong>@exam.Title</strong> which is currently <strong>Published (Active)</strong>. Deleting it will immediately affect learners taking this exam.
                        </div>
                    </div>
                }
            </div>
        </div>

        <form method="post" asp-page-handler="Delete" class="flex justify-end gap-sm pt-md border-t border-outline-variant/30 mt-md">
            <input type="hidden" name="id" value="@exam.Id" />
            <input type="hidden" name="contentType" id="deleteContentTypeInput" value="" />
            <input type="hidden" name="targetId" id="deleteTargetIdInput" value="0" />
            <button type="button" onclick="closeDeleteModal()" class="qc-btn-ghost">Cancel</button>
            <button type="submit" class="bg-error text-on-error hover:opacity-90 font-label-lg text-label-lg px-5 py-2.5 rounded-xl font-semibold transition-all flex items-center gap-xs shadow-sm">
                <span class="material-symbols-outlined text-sm">delete</span>
                Delete Permanently
            </button>
        </form>
    </div>
</div>

<script>
    function confirmDelete(contentType, targetId, displayName) {
        document.getElementById('deleteContentTypeInput').value = contentType;
        document.getElementById('deleteTargetIdInput').value = targetId;
        document.getElementById('deleteTargetName').textContent = displayName || 'this item';
        document.getElementById('deleteConfirmModal')?.classList.remove('hidden');
    }
    function closeDeleteModal() {
        document.getElementById('deleteConfirmModal')?.classList.add('hidden');
    }
</script>
