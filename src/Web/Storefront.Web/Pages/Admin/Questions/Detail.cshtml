@page
@model Storefront.Web.Pages.Admin.Questions.DetailModel
@{
    Layout = "_ModeratorLayout";
    var q = Model.Question;
    ViewData["Title"] = $"Question #{q.QuestionNumber} (Part {q.Part}) - Detail";

    string builderEditUrl = q.Part switch
    {
        1 or 2 => $"/Admin/Exams/{q.ExamId}/Questions/Create/ListeningQuestion?part={q.Part}&editId={q.Id}",
        3 or 4 when q.QuestionGroupId.HasValue => $"/Admin/Exams/{q.ExamId}/Questions/Create/Listening?part={q.Part}&groupId={q.QuestionGroupId}",
        5 => $"/Admin/Exams/{q.ExamId}/Questions/Create/Part5?editId={q.Id}",
        6 when q.PassageId.HasValue => $"/Admin/Exams/{q.ExamId}/Questions/Create/Part6?passageId={q.PassageId}",
        7 when q.QuestionGroupId.HasValue => $"/Admin/Exams/{q.ExamId}/Questions/Create/Part7?groupId={q.QuestionGroupId}",
        _ => $"/Admin/Exams/Edit?id={q.ExamId}"
    };
}

<link rel="stylesheet" href="~/css/admin-question-create.css" />

<div class="w-full flex flex-col gap-lg pb-12">
    <!-- BREADCRUMB -->
    <nav class="qc-breadcrumb" aria-label="Breadcrumb">
        <a href="/Admin/Questions">Question Bank</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="qc-breadcrumb-current">Question #@q.QuestionNumber (Part @q.Part)</span>
    </nav>

    <!-- ALERTS -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="bg-tertiary-fixed/30 border border-tertiary text-on-tertiary-fixed-variant rounded-xl p-md flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-sm">
                <span class="material-symbols-outlined text-tertiary">check_circle</span>
                <span class="font-body-md font-medium">@Model.SuccessMessage</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-on-tertiary-fixed-variant hover:opacity-75">
                <span class="material-symbols-outlined text-sm">close</span>
            </button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-error-container border border-error text-on-error-container rounded-xl p-md flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-sm">
                <span class="material-symbols-outlined text-error">error</span>
                <span class="font-body-md font-medium">@Model.ErrorMessage</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-on-error-container hover:opacity-75">
                <span class="material-symbols-outlined text-sm">close</span>
            </button>
        </div>
    }

    <!-- HERO HEADER -->
    <div class="qc-page-hero">
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-md">
            <div class="flex items-start gap-md">
                <div class="hidden sm:flex w-12 h-12 rounded-xl bg-primary/10 items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-primary text-[28px]">quiz</span>
                </div>
                <div>
                    <div class="flex items-center gap-sm flex-wrap">
                        <span class="font-label-sm text-label-sm text-outline font-bold">QUESTION ID: #@q.Id</span>
                        <span class="qc-part-badge qc-part-badge--primary">Part @q.Part</span>
                        <span class="qc-part-badge qc-part-badge--tertiary">Difficulty: @q.Difficulty</span>
                        @if (!string.IsNullOrEmpty(q.QuestionType))
                        {
                            <span class="qc-part-badge">@q.QuestionType</span>
                        }
                        @if (!string.IsNullOrEmpty(q.TopicTag))
                        {
                            <span class="qc-part-badge">#@q.TopicTag</span>
                        }
                    </div>
                    <h1 class="font-headline-md text-headline-md font-bold text-on-surface mt-xs">
                        Question #@q.QuestionNumber — @(string.IsNullOrWhiteSpace(q.QuestionText) ? $"Part {q.Part} Listening Item" : q.QuestionText)
                    </h1>
                </div>
            </div>

            <div class="flex items-center gap-sm flex-wrap">
                <a href="/Admin/Questions" class="qc-btn-ghost">
                    <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                    Back to List
                </a>
                <a href="@builderEditUrl" class="qc-btn-secondary">
                    <span class="material-symbols-outlined text-[18px]">open_in_new</span>
                    Open in Part @q.Part Builder
                </a>
                <button type="button" onclick="document.getElementById('deleteDetailModal').classList.remove('hidden')" class="bg-error text-on-error hover:opacity-90 px-4 py-2.5 rounded-xl font-label-md text-label-md font-semibold flex items-center gap-xs transition-all">
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                    Delete
                </button>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-lg items-start">
        <!-- LEFT 7 COLS: QUESTION PREVIEW & EMBEDDED EXAMS (UC-17.3) -->
        <div class="lg:col-span-7 flex flex-col gap-lg">
            <!-- Question Content Card -->
            <div class="qc-section-card flex flex-col gap-md">
                <div class="qc-section-title">
                    <span class="material-symbols-outlined">visibility</span>
                    <h3>Question Preview &amp; Answer Breakdown (UC-17.3)</h3>
                </div>

                @if (!string.IsNullOrEmpty(q.QuestionGroupName))
                {
                    <div class="p-sm rounded-lg bg-primary/5 border border-primary/20 flex items-center gap-xs text-primary font-label-md text-label-md">
                        <span class="material-symbols-outlined text-[18px]">folder_special</span>
                        Belongs to Set/Group: <strong>@q.QuestionGroupName</strong>
                    </div>
                }

                @if (!string.IsNullOrEmpty(q.PassageContent))
                {
                    <div class="p-md rounded-xl bg-surface-container-low border border-outline-variant/30">
                        <span class="font-label-sm text-label-sm uppercase text-outline font-bold block mb-xs">Reading Passage Content</span>
                        <div class="font-body-sm text-body-sm text-on-surface whitespace-pre-line leading-relaxed">@q.PassageContent</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(q.ImageUrl) || !string.IsNullOrEmpty(q.PassageImageUrl))
                {
                    <div class="p-md rounded-xl bg-surface-container-low border border-outline-variant/30">
                        <span class="font-label-sm text-label-sm uppercase text-outline font-bold block mb-xs">Attached Photograph / Graphic</span>
                        <img src="@(q.ImageUrl ?? q.PassageImageUrl)" alt="Question Graphic" class="max-h-72 rounded-lg object-contain border border-outline-variant/20" />
                    </div>
                }

                @if (!string.IsNullOrEmpty(q.AudioUrl))
                {
                    <div class="p-md rounded-xl bg-surface-container-low border border-outline-variant/30 flex flex-col gap-xs">
                        <div class="flex items-center justify-between">
                            <span class="font-label-sm text-label-sm uppercase text-outline font-bold flex items-center gap-1">
                                <span class="material-symbols-outlined text-primary text-sm">audiotrack</span>
                                Audio Track
                            </span>
                            @if (q.AudioStartSecond.HasValue && q.AudioEndSecond.HasValue)
                            {
                                <span class="text-xs font-bold text-primary bg-primary/10 px-2.5 py-0.5 rounded-full">
                                    Segment: @(q.AudioStartSecond)s → @(q.AudioEndSecond)s
                                </span>
                            }
                        </div>
                        <audio controls src="@q.AudioUrl" class="w-full mt-1"></audio>
                    </div>
                }

                <!-- Stem -->
                <div class="p-md rounded-xl bg-surface border border-outline-variant/25">
                    <span class="font-label-sm text-label-sm uppercase text-outline font-bold block mb-1">Question Stem</span>
                    <p class="font-title-md text-title-md font-semibold text-on-surface">
                        Q@(q.QuestionNumber). @(string.IsNullOrWhiteSpace(q.QuestionText) ? "(Audio-only prompt)" : q.QuestionText)
                    </p>
                </div>

                <!-- Options -->
                <div class="flex flex-col gap-sm">
                    <span class="font-label-sm text-label-sm uppercase text-outline font-bold">Answer Choices</span>
                    @foreach (var opt in q.Options.OrderBy(o => o.OptionLetter))
                    {
                        var isCorrect = opt.OptionLetter == q.CorrectOption;
                        <div class="flex items-center justify-between p-3.5 rounded-xl border transition-all @(isCorrect ? "bg-tertiary-fixed/25 border-tertiary text-on-tertiary-fixed-variant font-bold" : "bg-surface border-outline-variant/30 text-on-surface")">
                            <div class="flex items-center gap-sm">
                                <span class="w-7 h-7 rounded-full flex items-center justify-center font-label-md text-label-md @(isCorrect ? "bg-tertiary text-on-tertiary" : "bg-surface-container text-on-surface-variant")">
                                    @opt.OptionLetter
                                </span>
                                <span class="font-body-md text-body-md">@opt.OptionText</span>
                            </div>
                            @if (isCorrect)
                            {
                                <span class="inline-flex items-center gap-1 text-xs font-bold text-tertiary bg-tertiary-fixed/40 px-2.5 py-1 rounded-full">
                                    <span class="material-symbols-outlined text-[15px]">check_circle</span>
                                    Correct Answer
                                </span>
                            }
                        </div>
                    }
                </div>

                <!-- Explanation -->
                <div class="p-md rounded-xl bg-primary/5 border border-primary/20">
                    <span class="font-label-sm text-label-sm uppercase text-primary font-bold flex items-center gap-1 mb-1">
                        <span class="material-symbols-outlined text-[16px]">lightbulb</span>
                        Explanation / Solution Rationale
                    </span>
                    <p class="font-body-sm text-body-sm text-on-surface leading-relaxed">
                        @(string.IsNullOrWhiteSpace(q.Explanation) ? "No explanation provided yet." : q.Explanation)
                    </p>
                </div>
            </div>

            <!-- Embedded Exams Card (UC-17.3: Chi tiết câu hỏi + các đề đang nhúng) -->
            <div class="qc-section-card flex flex-col gap-md">
                <div class="qc-section-title">
                    <span class="material-symbols-outlined">inventory_2</span>
                    <h3>Embedded Exams (@q.EmbeddedExams.Count)</h3>
                </div>
                <p class="font-body-xs text-body-xs text-on-surface-variant -mt-2">
                    List of exams currently embedding this question in Content Service.
                </p>

                <div class="flex flex-col gap-sm">
                    @foreach (var ex in q.EmbeddedExams)
                    {
                        <div class="p-md rounded-xl border border-outline-variant/30 bg-surface flex flex-col sm:flex-row sm:items-center justify-between gap-sm">
                            <div>
                                <div class="flex items-center gap-sm flex-wrap">
                                    <span class="font-label-xs text-label-xs text-outline font-bold">EXAM #@ex.ExamId</span>
                                    <span class="px-2 py-0.5 rounded text-xs font-semibold bg-primary/10 text-primary">@ex.ExamType</span>
                                    @if (ex.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-tertiary-fixed text-on-tertiary-fixed-variant">
                                            <span class="material-symbols-outlined text-[13px]">visibility</span>
                                            Published (Active)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-secondary-container text-on-secondary-container">
                                            @ex.Status
                                        </span>
                                    }
                                </div>
                                <h4 class="font-title-md text-title-md font-bold text-on-surface mt-1">@ex.ExamTitle</h4>
                                <p class="font-body-xs text-body-xs text-on-surface-variant mt-0.5">
                                    Series: @(ex.ExamSeriesName ?? "General") · Duration: @ex.Duration mins
                                </p>
                            </div>
                            <div class="flex items-center gap-xs">
                                <a href="/Admin/Exams/Detail?id=@ex.ExamId" class="qc-btn-ghost text-xs py-1.5 px-3">View Exam</a>
                                <a href="/Admin/Exams/Edit?id=@ex.ExamId" class="qc-btn-secondary text-xs py-1.5 px-3">Edit Exam Tree</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT 5 COLS: QUICK UPDATE QUESTION / AUDIO / ANSWERS FORM (UC-17.4) -->
        <div class="lg:col-span-5">
            <div class="qc-section-card flex flex-col gap-md">
                <div class="qc-section-title">
                    <span class="material-symbols-outlined">edit_square</span>
                    <h3>Update Question / Audio / Answers (UC-17.4)</h3>
                </div>

                <form method="post" asp-page-handler="Update" asp-route-id="@q.Id" enctype="multipart/form-data" class="flex flex-col gap-md">
                    <input type="hidden" asp-for="EditForm.QuestionId" />
                    <input type="hidden" asp-for="EditForm.AudioUrl" />
                    <input type="hidden" asp-for="EditForm.ImageUrl" />

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-sm">
                        <div class="flex flex-col gap-2xs sm:col-span-2">
                            <label class="qc-label">Embedded Exam</label>
                            <select asp-for="EditForm.ExamId" class="qc-select">
                                @foreach (var ex in Model.Exams)
                                {
                                    <option value="@ex.Id">@ex.Title (@ex.Status)</option>
                                }
                            </select>
                        </div>

                        <div class="flex flex-col gap-2xs">
                            <label class="qc-label">Part (1–7)</label>
                            <select asp-for="EditForm.Part" class="qc-select">
                                @for (int p = 1; p <= 7; p++)
                                {
                                    <option value="@p">Part @p</option>
                                }
                            </select>
                        </div>

                        <div class="flex flex-col gap-2xs">
                            <label class="qc-label">Question Number</label>
                            <input type="number" asp-for="EditForm.QuestionNumber" min="1" max="200" class="qc-input" required />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-sm">
                        <div class="flex flex-col gap-2xs">
                            <label class="qc-label">Difficulty</label>
                            <select asp-for="EditForm.Difficulty" class="qc-select">
                                <option value="Easy">Easy</option>
                                <option value="Medium">Medium</option>
                                <option value="Hard">Hard</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-2xs">
                            <label class="qc-label">Question Type</label>
                            <input type="text" asp-for="EditForm.QuestionType" class="qc-input" />
                        </div>
                        <div class="flex flex-col gap-2xs">
                            <label class="qc-label">Topic Tag</label>
                            <input type="text" asp-for="EditForm.TopicTag" class="qc-input" />
                        </div>
                    </div>

                    <div class="flex flex-col gap-2xs">
                        <label class="qc-label">Question Text</label>
                        <textarea asp-for="EditForm.QuestionText" rows="3" class="qc-textarea"></textarea>
                    </div>

                    <div class="grid grid-cols-1 gap-sm p-sm rounded-xl bg-surface-container-low/50 border border-outline-variant/20">
                        <div class="flex flex-col gap-2xs">
                            <label class="qc-label">Replace Audio File (.mp3 / .wav)</label>
                            <input type="file" asp-for="EditForm.AudioFile" accept="audio/*" class="text-xs text-on-surface-variant" />
                        </div>
                        <div class="flex flex-col gap-2xs">
                            <label class="qc-label">Replace Image File (.png / .jpg)</label>
                            <input type="file" asp-for="EditForm.ImageFile" accept="image/*" class="text-xs text-on-surface-variant" />
                        </div>
                    </div>

                    <div class="flex flex-col gap-xs">
                        <label class="qc-label">Options &amp; Correct Answer</label>
                        <div class="flex flex-col gap-xs">
                            <div class="qc-option-row">
                                <span class="qc-option-badge">A</span>
                                <input type="text" asp-for="EditForm.OptionA" required />
                                <input type="radio" asp-for="EditForm.CorrectOption" value="A" />
                            </div>
                            <div class="qc-option-row">
                                <span class="qc-option-badge">B</span>
                                <input type="text" asp-for="EditForm.OptionB" required />
                                <input type="radio" asp-for="EditForm.CorrectOption" value="B" />
                            </div>
                            <div class="qc-option-row">
                                <span class="qc-option-badge">C</span>
                                <input type="text" asp-for="EditForm.OptionC" required />
                                <input type="radio" asp-for="EditForm.CorrectOption" value="C" />
                            </div>
                            @if (q.Part != 2)
                            {
                                <div class="qc-option-row">
                                    <span class="qc-option-badge">D</span>
                                    <input type="text" asp-for="EditForm.OptionD" />
                                    <input type="radio" asp-for="EditForm.CorrectOption" value="D" />
                                </div>
                            }
                        </div>
                    </div>

                    <div class="flex flex-col gap-2xs">
                        <label class="qc-label">Explanation</label>
                        <textarea asp-for="EditForm.Explanation" rows="3" class="qc-textarea"></textarea>
                    </div>

                    <button type="submit" class="qc-btn-primary w-full justify-center">
                        <span class="material-symbols-outlined text-[18px]">save</span>
                        Save Changes
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- DELETE MODAL WITH ACTIVE EXAM WARNING -->
<div id="deleteDetailModal" class="qc-modal hidden">
    <div class="qc-modal__backdrop" onclick="document.getElementById('deleteDetailModal').classList.add('hidden')"></div>
    <div class="qc-modal__panel">
        <div class="flex items-start gap-md">
            <div class="w-12 h-12 rounded-full bg-error-container text-on-error-container flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-error">warning</span>
            </div>
            <div class="flex-1">
                <h4 class="font-title-lg text-title-lg font-bold text-on-surface">Delete Question #@q.QuestionNumber</h4>
                <p class="font-body-md text-body-md text-on-surface-variant mt-xs">
                    Are you sure you want to permanently delete <strong>Question #@q.QuestionNumber (Part @q.Part)</strong>?
                </p>

                @if (q.IsExamActive)
                {
                    <div class="mt-md p-3.5 rounded-xl bg-error-container/45 border border-error text-on-error-container flex items-start gap-xs">
                        <span class="material-symbols-outlined text-error text-[20px] mt-0.5">report</span>
                        <div class="text-xs leading-relaxed">
                            <strong>Active Exam Warning:</strong> This question belongs to <strong>@q.ExamTitle</strong> which is currently <strong>Published (Active)</strong>. Deleting it will immediately remove it from the active exam!
                        </div>
                    </div>
                }
            </div>
        </div>

        <form method="post" asp-page-handler="Delete" asp-route-id="@q.Id" class="flex justify-end gap-sm pt-md border-t border-outline-variant/30 mt-md">
            <button type="button" onclick="document.getElementById('deleteDetailModal').classList.add('hidden')" class="qc-btn-ghost">Cancel</button>
            <button type="submit" class="bg-error text-on-error hover:opacity-90 font-label-lg text-label-lg px-5 py-2.5 rounded-xl font-semibold transition-all flex items-center gap-xs shadow-sm">
                <span class="material-symbols-outlined text-sm">delete</span>
                Delete Permanently
            </button>
        </form>
    </div>
</div>
