@model int?
<a asp-page="/Notifications/Index" class="relative inline-flex items-center text-primary p-sm" aria-label="Notifications" title="@(Model.HasValue ? $"{Model.Value} unread notifications" : "Unable to load unread notification count")">
    <span class="material-symbols-outlined" aria-hidden="true">notifications</span>
    @if (Model > 0) { <span class="rounded-full bg-error text-white text-xs px-1.5 min-w-5 text-center">@(Model > 99 ? "99+" : Model.ToString())</span> }
    else if (!Model.HasValue) { <span class="text-on-surface-variant text-xs" aria-hidden="true">?</span> }
</a>
