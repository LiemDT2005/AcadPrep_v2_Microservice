@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Storefront.Web.Services.BillingApiClient BillingApi
@{
    var name = Context.Session.GetString("name");
    var avatar = Context.Session.GetString("avatar");
    var jwtToken = Context.Session.GetString("jwt");
    var roles = Context.Session.GetString("roles") ?? string.Empty;
    var isAdmin = roles.Split(',').Contains("Admin");
    var isModerator = roles.Split(',').Contains("Moderator");
    var isLearner = !string.IsNullOrEmpty(jwtToken) && roles.Split(',', StringSplitOptions.TrimEntries).Contains("Learner");
    var staffDashboard = isAdmin ? "/Admin/Dashboard" : "/Admin/Exams";
    var isAuthenticated = !string.IsNullOrEmpty(name);
    var showProBadge = false;
    if (isLearner && !isAdmin && !isModerator)
    {
        if (ViewData.Model is Storefront.Web.Pages.Billing.PlansModel plans)
        {
            showProBadge = plans.Current is { Status: "Active", IsPro: true };
        }
        else
        {
            using var badgeTimeout = CancellationTokenSource.CreateLinkedTokenSource(Context.RequestAborted);
            badgeTimeout.CancelAfter(TimeSpan.FromSeconds(2));
            try
            {
                var result = await BillingApi.GetMySubscriptionAsync(badgeTimeout.Token);
                showProBadge = result.Success && result.Data is { Status: "Active", IsPro: true };
            }
            catch (OperationCanceledException) when (!Context.RequestAborted.IsCancellationRequested)
            {
                // The header still renders when Billing does not answer in time.
            }
        }
    }

    var fallbackAvatar = $"https://api.dicebear.com/9.x/initials/svg?seed={Uri.EscapeDataString(string.IsNullOrWhiteSpace(name) ? "AcadPrep" : name)}";
    var userAvatar = string.IsNullOrWhiteSpace(avatar) ? fallbackAvatar : avatar;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcadPrep</title>

    <!-- Google Fonts & Material Symbols & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <!-- Tailwind CSS with Monolith Custom Palette -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              colors: {
                  "background": "#fcf8ff",
                  "primary": "#4840E4",
                  "primary-container": "#3525cd",
                  "on-primary": "#ffffff",
                  "on-surface": "#1b1b24",
                  "on-surface-variant": "#464555",
                  "surface-container-lowest": "#ffffff",
                  "surface-container-low": "#f5f2ff",
                  "surface-container": "#efe9f8",
                  "surface-container-high": "#e9e4f0",
                  "surface-variant": "#e5e1ec",
                  "outline": "#787680",
                  "outline-variant": "#c7c4d8",
                  "secondary": "#5e5c71",
                  "secondary-container": "#e4dffa",
                  "on-secondary-container": "#1b1a2c",
                  "tertiary": "#006c4c",
                  "tertiary-container": "#89f8c7",
                  "on-tertiary-container": "#002115",
                  "error": "#ba1a1a",
                  "error-container": "#ffdad6",
                  "on-error-container": "#410002"
              },
              spacing: {
                  "xs": "4px", "sm": "8px", "md": "16px", "lg": "24px", "xl": "32px", "2xl": "48px", "3xl": "64px",
                  "margin-mobile": "16px", "margin-desktop": "40px"
              },
              fontSize: {
                  "display-lg": ["57px", { lineHeight: "64px", letterSpacing: "-0.25px" }],
                  "display-md": ["45px", { lineHeight: "52px" }],
                  "display-sm": ["36px", { lineHeight: "44px" }],
                  "headline-lg": ["32px", { lineHeight: "40px" }],
                  "headline-md": ["28px", { lineHeight: "36px" }],
                  "headline-sm": ["20px", { lineHeight: "28px" }],
                  "body-lg": ["16px", { lineHeight: "24px", letterSpacing: "0.5px" }],
                  "body-md": ["14px", { lineHeight: "20px", letterSpacing: "0.25px" }],
                  "body-sm": ["12px", { lineHeight: "16px", letterSpacing: "0.4px" }],
                  "label-lg": ["14px", { lineHeight: "20px", letterSpacing: "0.1px" }],
                  "label-md": ["12px", { lineHeight: "16px", letterSpacing: "0.5px" }],
                  "label-sm": ["11px", { lineHeight: "16px", letterSpacing: "0.5px" }]
              },
              fontFamily: {
                  "display-lg": ["Inter", "sans-serif"],
                  "display-md": ["Inter", "sans-serif"],
                  "display-sm": ["Inter", "sans-serif"],
                  "headline-lg": ["Inter", "sans-serif"],
                  "headline-md": ["Inter", "sans-serif"],
                  "headline-sm": ["Inter", "sans-serif"],
                  "body-lg": ["Inter", "sans-serif"],
                  "body-md": ["Inter", "sans-serif"],
                  "body-sm": ["Inter", "sans-serif"],
                  "label-lg": ["Inter", "sans-serif"],
                  "label-md": ["Inter", "sans-serif"],
                  "label-sm": ["Inter", "sans-serif"]
              }
            }
          }
        }
    </script>
</head>
<body class="bg-background text-on-surface min-h-screen flex flex-col font-[Inter]">
    @{
        var userName = Context.Session.GetString("name");
        var hasUser = !string.IsNullOrEmpty(Context.Session.GetString("jwt"));
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
        string NavClass(string page) => currentPage == page || (page != "/Index" && currentPage?.StartsWith(page.Replace("/Index", "") + "/") == true)
            ? "text-primary font-semibold border-b-2 border-primary"
            : "text-on-surface-variant font-medium hover:text-primary";
    }

    <!-- Sticky Header -->
    <header class="sticky top-0 z-50 bg-surface-container-lowest border-b border-outline-variant/30 w-full shadow-sm">
        <div class="storefront-header-row @(isAdmin || isModerator ? "storefront-header-row-staff" : "")">
            <!-- Brand Logo -->
            <a class="flex shrink-0 items-center gap-sm group" asp-page="/Index" style="text-decoration:none;">
                <span class="material-symbols-outlined text-primary text-[28px]" style="font-variation-settings: 'FILL' 1;">school</span>
                <span class="text-[20px] font-bold text-primary-container leading-[28px]">AcadPrep</span>
            </a>

            <!-- Navigation Links -->
            <nav class="storefront-header-nav" aria-label="Main navigation">
                <a class="h-full flex items-center px-sm text-[14px] @NavClass("/Index") transition-colors" asp-page="/Index" style="text-decoration:none;">Home</a>
                <a class="h-full flex items-center px-sm text-[14px] @NavClass("/Exams/Index") transition-colors" asp-page="/Exams/Index" style="text-decoration:none;">Practice tests</a>
                <a class="h-full flex items-center px-sm text-[14px] @NavClass("/Progress/Index") transition-colors" asp-page="/Progress/Index" style="text-decoration:none;">Progress</a>
                <a class="h-full flex items-center px-sm text-[14px] @NavClass("/Vocabulary/Notebook") transition-colors" asp-page="/Vocabulary/Notebook" style="text-decoration:none;">Vocabulary</a>
                <a class="h-full flex items-center px-sm text-[14px] @NavClass("/Vocabulary/Review") transition-colors" asp-page="/Vocabulary/Review" style="text-decoration:none;">Flashcards</a>
                <a class="h-full flex items-center px-sm text-[14px]" asp-page="/Performance/StudyHistory">Study history</a>
                <a class="h-full flex items-center px-sm text-[14px]" asp-page="/Performance/PerformanceAnalysis">Analysis</a>
                <a class="h-full flex items-center px-sm text-[14px] @NavClass("/Performance/Leaderboard") transition-colors" asp-page="/Performance/Leaderboard" style="text-decoration:none;">Leaderboard</a>
                @if (isAdmin || isModerator)
                {
                <a href="/Admin/Exams" class="inline-flex items-center px-2.5 py-1 text-xs font-bold uppercase rounded bg-purple-100 text-purple-700 hover:bg-purple-200 transition" style="text-decoration:none;">
                    Exam CMS
                </a>
                }
                @if (isAdmin)
                {
                    <a asp-page="/Admin/Users/Index" class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-bold uppercase rounded bg-indigo-100 text-indigo-700 hover:bg-indigo-200 transition" style="text-decoration:none;">
                        <span class="material-symbols-outlined text-[14px]">admin_panel_settings</span> CMS Users
                    </a>
                }
            </nav>

            <!-- Trailing Actions -->
            <div class="storefront-header-actions flex shrink-0 items-center gap-2 xl:gap-md whitespace-nowrap">
                @if (isLearner)
                {
                    <details class="relative text-sm">
                        <summary class="cursor-pointer whitespace-nowrap font-semibold text-primary">Upgrade</summary>
                        <nav aria-label="Upgrade" class="absolute right-0 top-full z-50 mt-2 w-44 rounded-lg border border-outline-variant bg-surface-container-lowest p-2 shadow-lg">
                            <a asp-page="/Billing/Plans" class="block rounded px-3 py-2 hover:bg-surface-container-low">Pricing</a>
                            <a asp-page="/Billing/Orders/Index" class="block rounded px-3 py-2 hover:bg-surface-container-low">My orders</a>
                        </nav>
                    </details>
                }
                else if (!hasUser)
                {
                    <a asp-page="/Billing/Plans" class="text-sm font-semibold text-primary hover:underline">Upgrade</a>
                }
                @if (hasUser && (isAdmin || isModerator))
                {
                    <a href="@staffDashboard" class="text-sm font-semibold text-primary hover:underline">Dashboard</a>
                }
                @await Component.InvokeAsync("NotificationBadge")
                @if (hasUser)
                {
                    <a asp-page="/Account/Profile" class="flex items-center gap-2 hover:opacity-80 transition" style="text-decoration:none;" title="Account">
                        <span class="flex flex-col items-center gap-0.5">
                            <img src="@userAvatar" alt="@userName" class="w-8 h-8 rounded-full object-cover border border-primary/20 shadow-sm" />
                            @if (showProBadge)
                            {
                                <span class="storefront-pro-badge">PRO</span>
                            }
                        </span>
                        <span class="hidden max-w-28 truncate text-sm font-semibold text-on-surface xl:block">@userName</span>
                    </a>
                    <form method="post" asp-page="/Account/Logout" class="inline m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                           class="inline-flex items-center justify-center px-md py-sm rounded-lg border border-outline-variant text-on-surface text-[14px] font-medium hover:bg-surface-container-low transition-colors duration-100 cursor-pointer bg-transparent"
                           style="text-decoration:none;">Log out</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Account/Login"
                       class="inline-flex items-center justify-center px-md py-sm rounded-lg border border-outline-variant text-on-surface text-[14px] font-medium hover:bg-surface-container-low transition-colors duration-100"
                       style="text-decoration:none;">Log in</a>
                    <a asp-page="/Account/Register"
                       class="inline-flex items-center justify-center px-md py-sm rounded-lg bg-primary text-white text-[14px] font-medium hover:opacity-90 active:scale-95 transition-all duration-100 shadow-sm border-0"
                       style="text-decoration:none;">Sign up</a>
                }
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main role="main" class="flex-grow w-full @ViewData["ContentClass"]">
        @RenderBody()
    </main>

    <!-- Footer -->
    @if (ViewData["IsHomePage"] as bool? == true)
    {
        <partial name="_HomeFooter" />
    }
    else
    {
    <footer class="bg-surface-container border-t border-outline-variant/30 pt-xl pb-lg mt-auto">
        <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin-desktop flex flex-col md:flex-row justify-between items-center gap-md">
            <div>
                <p class="font-extrabold text-primary text-lg">AcadPrep</p>
                <p class="text-body-sm text-on-surface-variant">Prepare smarter for TOEIC with AcadPrep.</p>
            </div>
            <div class="flex flex-wrap gap-lg text-body-sm text-on-surface-variant">
                <a asp-page="/Exams/Index" class="hover:text-primary transition-colors">Practice tests</a>
                <a asp-page="/Progress/Index" class="hover:text-primary transition-colors">Progress</a>
                <a asp-page="/Performance/Leaderboard" class="hover:text-primary transition-colors">Leaderboard</a>
                <a href="/Admin/Exams" class="hover:text-primary transition-colors">Exam CMS</a>
                @if (isAdmin)
                {
                    <a asp-page="/Admin/Users/Index" class="hover:text-primary transition-colors">CMS Users</a>
                }
            </div>
        </div>
    </footer>
    }

    @await RenderSectionAsync("Scripts", required: false)

    @* AcadPrep AI Tutor widget (UC-22.1), Learner sessions only — approved shared layout change (Huy, 2026-11-05). *@
    @if (isLearner)
    {
        @await Component.InvokeAsync("AiChatWidget")
        <script src="~/js/ai-chat-widget.js" asp-append-version="true"></script>
    }

    <partial name="_AccountSession" />

</body>
</html>
