<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TOEIC Learning</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" asp-page="/Index">TOEIC Learning</a>
    <nav>
        <a asp-page="/Courses/Index">Khóa học</a>
        <a asp-page="/Exams/Index">Luyện đề</a>
        <a asp-page="/Progress/Index">Tiến độ</a>
        @{
            var name = Context.Session.GetString("name");
            var avatar = Context.Session.GetString("avatar");
        }
        @if (string.IsNullOrEmpty(name))
        {
            <a asp-page="/Account/Login" class="btn">Đăng nhập</a>
            <a asp-page="/Account/Register" class="btn btn-outline">Đăng ký</a>
        }
        else
        {
            <a asp-page="/Account/Profile" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: var(--ink); font-weight: 600;">
                @if (!string.IsNullOrEmpty(avatar))
                {
                    <img src="@avatar" alt="@name" style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover;" />
                }
                else
                {
                    <span style="width: 28px; height: 28px; border-radius: 50%; background: var(--brand); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: bold;">
                        @(string.IsNullOrWhiteSpace(name) ? "U" : name.Substring(0, 1).ToUpper())
                    </span>
                }
                <span>@name</span>
            </a>
            <a asp-page="/Account/Logout" class="btn btn-outline" style="font-size: 0.85rem; padding: 0.45rem 0.85rem;">Đăng xuất</a>
        }
    </nav>
</header>
<main class="container">
    @RenderBody()
</main>
<footer class="footer">
    <p>Demo microservices · Clean Architecture · YARP · RabbitMQ · Redis · Razor Pages</p>
</footer>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
