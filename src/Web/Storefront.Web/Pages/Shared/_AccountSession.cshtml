@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var jwtToken = Context.Session.GetString("jwt");
}
    @if (!string.IsNullOrEmpty(jwtToken))
    {
        var gatewayUrl = Configuration["GatewayUrl"] ?? "http://localhost:5080";
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
        <script>
            (function() {
                const token = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(jwtToken));
                const configuredGateway = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(gatewayUrl));
                // Resolve Docker internal alias to client-accessible host
                let effectiveGateway = configuredGateway;
                if (!effectiveGateway || effectiveGateway.includes("apigateway")) {
                    effectiveGateway = `${window.location.protocol}//${window.location.hostname}:5080`;
                }
                const hubUrl = `${effectiveGateway}/identity/hubs/user`;

                try {
                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl(hubUrl, {
                            accessTokenFactory: () => token
                        })
                        .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                        .build();

                    connection.on("ForceLogout", function (reason) {
                        alert(`⚠️ YOUR ACCOUNT HAS BEEN BANNED!\n\nReason: ${reason || 'Violation of system policies'}\n\nYou will be logged out immediately.`);
                        window.location.href = '/Account/Logout';
                    });

                    connection.start().catch(err => {
                        console.warn("[SignalR ForceLogout] Hub connection error:", err.toString());
                    });
                } catch (e) {
                    console.warn("[SignalR ForceLogout] Hub initialization error:", e);
                }
            })();
        </script>
    }
