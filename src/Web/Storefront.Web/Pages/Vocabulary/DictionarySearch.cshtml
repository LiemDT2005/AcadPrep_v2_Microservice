@page
@model Storefront.Web.Pages.Vocabulary.DictionarySearchModel
@{
    ViewData["Title"] = "Tra Cứu Từ Điển TOEIC";
}

<div class="max-w-3xl mx-auto py-xl px-margin-mobile md:px-margin-desktop">
    <!-- Header -->
    <div class="mb-xl text-center mb-6">
        <h2 class="font-headline-md text-headline-md text-on-surface mb-xs font-bold text-2xl">Từ Điển TOEIC Chuyên Sâu</h2>
        <p class="font-body-md text-body-md text-on-surface-variant text-gray-600">Tra cứu định nghĩa, phiên âm quốc tế và lưu ngay vào sổ tay để ôn Flashcards.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-3 mb-4 text-sm text-green-800 bg-green-100 rounded-xl font-medium text-center">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-3 mb-4 text-sm text-red-800 bg-red-100 rounded-xl font-medium text-center">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Search Form -->
    <div class="bg-surface-container-lowest p-md rounded-2xl shadow-sm border border-outline-variant mb-6 bg-white p-4">
        <form method="get" class="flex gap-3">
            <div class="flex-1 relative">
                <input type="text" name="Keyword" value="@Model.Keyword" placeholder="Nhập từ vựng cần tra (ví dụ: Accommodate, Implement, Crucial...)" class="w-full px-4 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:border-primary" />
            </div>
            <button type="submit" class="bg-primary text-white px-5 py-2 rounded-xl text-sm font-semibold hover:bg-primary/90 transition shadow-sm">
                Tra cứu
            </button>
        </form>
    </div>

    <!-- Search Result -->
    @if (Model.HasSearched)
    {
        if (Model.Vocabulary != null)
        {
            var vocab = Model.Vocabulary;
            <div class="bg-white border border-gray-200 rounded-3xl p-8 shadow-sm">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-gray-100 pb-6 mb-6">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-full">TOEIC Vocabulary</span>
                        <h1 class="text-4xl font-black text-indigo-950 mt-2">@vocab.Word</h1>
                        @if (!string.IsNullOrEmpty(vocab.Phonetic))
                        {
                            <p class="text-gray-500 font-mono text-base italic mt-1">@vocab.Phonetic</p>
                        }
                    </div>
                    <div>
                        @if (Model.IsSavedInNotebook)
                        {
                            <span class="inline-flex items-center gap-1 bg-green-100 text-green-800 text-sm font-bold px-4 py-2 rounded-xl">
                                <span class="material-symbols-outlined text-[18px]">bookmark_added</span> Đã có trong sổ tay
                            </span>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Save">
                                <input type="hidden" name="vocabularyId" value="@vocab.VocabularyId" />
                                <button type="submit" class="inline-flex items-center gap-2 bg-primary text-white text-sm font-bold px-5 py-2.5 rounded-xl shadow hover:bg-primary/90 transition">
                                    <span class="material-symbols-outlined text-[18px]">bookmark_add</span> Lưu vào Sổ tay
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <h4 class="text-xs uppercase font-bold text-gray-400 tracking-wider">Định nghĩa</h4>
                        <p class="text-lg font-semibold text-gray-800 mt-1">@vocab.Meaning</p>
                    </div>

                    @if (!string.IsNullOrEmpty(vocab.Example))
                    {
                        <div>
                            <h4 class="text-xs uppercase font-bold text-gray-400 tracking-wider">Câu ví dụ trong ngữ cảnh</h4>
                            <p class="text-sm text-gray-700 bg-gray-50 p-3 rounded-xl italic border border-gray-100 mt-1">
                                "@vocab.Example"
                            </p>
                        </div>
                    }
                </div>

                <div class="mt-6 pt-4 border-t border-gray-100 flex gap-4 text-xs font-semibold">
                    <a href="/Vocabulary/VocabularyDetail/@vocab.VocabularyId" class="text-primary hover:underline inline-flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">article</span> Xem các đoạn văn đọc hiểu chứa từ
                    </a>
                    <a href="/Vocabulary/Notebook" class="text-gray-600 hover:underline inline-flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">book</span> Mở Sổ tay từ vựng
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-8 text-center">
                <span class="material-symbols-outlined text-[40px] text-gray-400 mb-2">sentiment_dissatisfied</span>
                <h3 class="font-bold text-gray-700">Không tìm thấy từ vựng "@Model.Keyword"</h3>
                <p class="text-sm text-gray-500 mt-1">Hãy thử tìm các từ mẫu có sẵn như: <em>Accommodate, Comprehensive, Implement, Crucial, Substantial, Negotiate...</em></p>
            </div>
        }
    }
</div>
