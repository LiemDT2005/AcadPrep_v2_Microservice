@page
@model Storefront.Web.Pages.Courses.IndexModel
@{ ViewData["Title"] = "Khóa học"; }
<h1>Khóa học TOEIC</h1>
<p class="meta">Dữ liệu từ Catalog microservice (Clean Architecture).</p>
<div class="grid">
@foreach (var c in Model.Courses)
{
    <div class="card">
        <span class="badge">@c.Level</span>
        <span class="badge">Mục tiêu @c.TargetScore</span>
        <h3>@c.Title</h3>
        <p class="meta">@c.LessonCount bài học</p>
        <p>@c.Description</p>
        <a class="btn" asp-page="./Details" asp-route-id="@c.Id">Chi tiết</a>
    </div>
}
</div>
