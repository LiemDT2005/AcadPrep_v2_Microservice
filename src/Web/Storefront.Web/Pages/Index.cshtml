@page
@model Storefront.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}
<section class="hero">
    <h1>Master TOEIC with Microservices Architecture</h1>
    <p>
        Full showcase: ASP.NET Identity + JWT · TOEIC Catalog · Part 5 Exam Practice · Event-Driven RabbitMQ ·
        Progress Tracking + Redis Cache · Razor Pages via YARP Gateway.
    </p>
    <div class="actions">
        <a class="btn" asp-page="/Courses/Index">Explore Courses</a>
        <a class="btn btn-outline" asp-page="/Exams/Index">Take Practice Test</a>
    </div>
</section>

<section class="grid">
    <div class="card"><h3>Identity</h3><p class="meta">ASP.NET Identity + JWT & RBAC</p></div>
    <div class="card"><h3>Catalog</h3><p class="meta">Clean Architecture + SQLite</p></div>
    <div class="card"><h3>Exam → Progress</h3><p class="meta">RabbitMQ Event-Driven</p></div>
    <div class="card"><h3>Gateway + Web</h3><p class="meta">YARP + Razor Pages</p></div>
</section>
