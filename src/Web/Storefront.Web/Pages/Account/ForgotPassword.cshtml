@page
@model Storefront.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password — AcadPrep";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Reset your AcadPrep account password." />

    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <script>
        tailwind.config = {
          theme: {
            extend: {
              colors: {
                primary:        "#1e00a9",
                "primary-dark": "#16007e",
                accent:         "#3525cd",
                muted:          "#464555",
                error:          "#ba1a1a",
                "error-bg":     "#ffdad6"
              },
              fontFamily: { sans: ["Inter", "sans-serif"] },
              boxShadow: { card: "0 4px 24px rgba(30,0,169,0.08), 0 1px 4px rgba(30,0,169,0.04)" }
            }
          }
        }
    </script>
    <style>
        body { font-family: "Inter", sans-serif; }
        .login-bg { background: linear-gradient(135deg, #1e00a9 0%, #3525cd 40%, #6b5fff 100%); }
        .glass-card { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
        .btn-primary { transition: transform 0.15s ease, box-shadow 0.15s ease; }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(30,0,169,0.35); }
        .input-wrap { position: relative; }
        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #787680;
            pointer-events: none;
            z-index: 1;
        }
        .input-field {
            box-sizing: border-box;
            width: 100%;
            padding-left: 2.75rem !important;
        }
    </style>
</head>
<body class="min-h-screen login-bg flex items-center justify-center p-4">

<div class="w-full max-w-md">

    <!-- Logo / Brand -->
    <div class="text-center mb-6">
        <a href="/" class="inline-flex items-center justify-center w-16 h-16 bg-white/20 rounded-2xl mb-3 backdrop-blur-sm shadow-md text-white no-underline hover:scale-105 transition-transform">
            <span class="material-symbols-outlined text-[36px]" style="font-variation-settings: 'FILL' 1;">school</span>
        </a>
        <h1 class="text-3xl font-extrabold text-white tracking-tight">AcadPrep</h1>
        <p class="text-white/80 text-sm mt-1">Recover Account Access</p>
    </div>

    <!-- Forgot Password Card -->
    <div class="glass-card bg-white rounded-3xl shadow-card p-7 sm:p-8">
        <div class="text-center mb-6">
            <div class="w-14 h-14 bg-indigo-50 text-primary rounded-full flex items-center justify-center mx-auto mb-3 shadow-inner">
                <span class="material-symbols-outlined text-[28px]">key</span>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 mb-1">Forgot Password?</h2>
            <p class="text-muted text-sm">Enter your registered email address to receive a password reset OTP code.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div role="alert" class="flex items-start gap-3 rounded-xl p-4 mb-5 bg-error-bg text-error text-sm">
                <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0 text-base"></i>
                <p class="m-0 font-medium">@Model.ErrorMessage</p>
            </div>
        }

        <form method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="mb-5">
                <label asp-for="Email" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">
                    Email Address
                </label>
                <div class="input-wrap">
                    <i class="fa-regular fa-envelope input-icon text-sm"></i>
                    <input asp-for="Email"
                           type="email"
                           placeholder="name@example.com"
                           class="input-field h-12 rounded-xl border border-gray-300 text-sm text-gray-900 placeholder-gray-400 focus:ring-0 transition-colors"
                           autofocus
                           required />
                </div>
                <span asp-validation-for="Email" class="text-xs text-red-600 mt-1 block font-medium"></span>
            </div>

            <button type="submit"
                    class="btn-primary w-full h-12 bg-primary hover:bg-primary-dark text-white font-semibold rounded-xl text-sm cursor-pointer shadow-md border-0 transition-colors">
                Send Verification OTP
            </button>
        </form>

        <p class="text-center text-sm text-gray-600 mt-6 mb-0">
            Remember your password?
            <a asp-page="/Account/Login" class="text-accent font-semibold hover:underline no-underline ml-1">
                Back to Sign In
            </a>
        </p>
    </div>

    <div class="text-center mt-6">
        <a href="/" class="text-white/80 hover:text-white text-xs inline-flex items-center gap-1.5 no-underline transition-opacity">
            <span class="material-symbols-outlined text-[16px]">arrow_back</span> Back to Home
        </a>
    </div>
</div>

</body>
</html>
