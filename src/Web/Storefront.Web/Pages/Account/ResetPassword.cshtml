@page
@model Storefront.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password — AcadPrep";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="Set a new password for your AcadPrep account." />

    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <script>
        tailwind.config = {
          theme: {
            extend: {
              colors: {
                primary:        "#1e00a9",
                "primary-dark": "#16007e",
                accent:         "#3525cd",
                muted:          "#464555",
                error:          "#ba1a1a",
                "error-bg":     "#ffdad6",
                success:        "#006c4c",
                "success-bg":   "#89f8c7"
              },
              fontFamily: { sans: ["Inter", "sans-serif"] },
              boxShadow: { card: "0 4px 24px rgba(30,0,169,0.08), 0 1px 4px rgba(30,0,169,0.04)" }
            }
          }
        }
    </script>
    <style>
        body { font-family: "Inter", sans-serif; }
        .login-bg { background: linear-gradient(135deg, #1e00a9 0%, #3525cd 40%, #6b5fff 100%); }
        .glass-card { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
        .btn-primary { transition: transform 0.15s ease, box-shadow 0.15s ease; }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(30,0,169,0.35); }
        .input-wrap { position: relative; }
        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #787680;
            pointer-events: none;
            z-index: 1;
        }
        .input-field {
            box-sizing: border-box;
            width: 100%;
            padding-left: 2.75rem !important;
        }
    </style>
</head>
<body class="min-h-screen login-bg flex items-center justify-center p-4">

<div class="w-full max-w-md">

    <!-- Logo / Brand -->
    <div class="text-center mb-6">
        <a href="/" class="inline-flex items-center justify-center w-16 h-16 bg-white/20 rounded-2xl mb-3 backdrop-blur-sm shadow-md text-white no-underline hover:scale-105 transition-transform">
            <span class="material-symbols-outlined text-[36px]" style="font-variation-settings: 'FILL' 1;">school</span>
        </a>
        <h1 class="text-3xl font-extrabold text-white tracking-tight">AcadPrep</h1>
        <p class="text-white/80 text-sm mt-1">Set Up New Secure Password</p>
    </div>

    <!-- Reset Password Card -->
    <div class="glass-card bg-white rounded-3xl shadow-card p-7 sm:p-8">
        <div class="text-center mb-6">
            <div class="w-14 h-14 bg-red-50 text-red-600 rounded-full flex items-center justify-center mx-auto mb-3 shadow-inner">
                <span class="material-symbols-outlined text-[28px]">lock_reset</span>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 mb-1">Reset Password</h2>
            <p class="text-muted text-xs sm:text-sm">An OTP code has been dispatched to email:</p>
            <p class="font-bold text-primary text-sm mt-1 break-all">@Model.Email</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div role="alert" class="flex items-start gap-3 rounded-xl p-4 mb-5 bg-green-50 text-green-800 text-sm border border-green-200">
                <i class="fa-solid fa-circle-check mt-0.5 shrink-0 text-base"></i>
                <p class="m-0 font-medium">@Model.SuccessMessage</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div role="alert" class="flex items-start gap-3 rounded-xl p-4 mb-5 bg-error-bg text-error text-sm">
                <i class="fa-solid fa-circle-exclamation mt-0.5 shrink-0 text-base"></i>
                <p class="m-0 font-medium">@Model.ErrorMessage</p>
            </div>
        }

        <form method="post" asp-page-handler="ResetPassword" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />

            <!-- OTP Input -->
            <div class="mb-4">
                <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5 text-center">
                    OTP Code (6 digits)
                </label>
                <input type="text"
                       asp-for="Otp"
                       maxlength="6"
                       autofocus
                       required
                       inputmode="numeric"
                       placeholder="123456"
                       class="w-full h-12 text-center text-xl font-bold tracking-[8px] rounded-xl border-2 border-gray-300 focus:border-primary focus:ring-0 text-gray-900" />
                <span asp-validation-for="Otp" class="text-xs text-red-600 mt-1 block font-medium text-center"></span>
            </div>

            <!-- New Password -->
            <div class="mb-4">
                <label asp-for="NewPassword" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">
                    New Password
                </label>
                <div class="input-wrap">
                    <i class="fa-solid fa-lock input-icon text-sm"></i>
                    <input type="password"
                           id="newPasswordInput"
                           asp-for="NewPassword"
                           placeholder="At least 6 characters"
                           required
                           minlength="6"
                           class="input-field h-12 rounded-xl border border-gray-300 text-sm text-gray-900 placeholder-gray-400 focus:ring-0 transition-colors" />
                </div>
                <div class="mt-2">
                    <div class="h-1.5 w-full bg-gray-200 rounded-full overflow-hidden">
                        <div id="strengthBar" class="h-full w-0 transition-all duration-300 bg-red-500"></div>
                    </div>
                    <small id="strengthText" class="block mt-1 text-[11px] text-gray-400 font-medium">Strength: Not entered</small>
                </div>
            </div>

            <!-- Confirm New Password -->
            <div class="mb-5">
                <label asp-for="ConfirmPassword" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1.5">
                    Confirm New Password
                </label>
                <div class="input-wrap">
                    <i class="fa-solid fa-shield-halved input-icon text-sm"></i>
                    <input type="password"
                           id="confirmPasswordInput"
                           asp-for="ConfirmPassword"
                           placeholder="Re-enter new password"
                           required
                           minlength="6"
                           class="input-field h-12 rounded-xl border border-gray-300 text-sm text-gray-900 placeholder-gray-400 focus:ring-0 transition-colors" />
                </div>
                <small id="matchText" class="hidden text-[11px] mt-1 font-medium"></small>
            </div>

            <button type="submit"
                    class="btn-primary w-full h-12 bg-primary hover:bg-primary-dark text-white font-semibold rounded-xl text-sm cursor-pointer shadow-md border-0 transition-colors">
                Save Password & Sign In
            </button>
        </form>

        <!-- Form Resend OTP -->
        <form method="post" asp-page-handler="ResendOtp" class="mt-6 text-center pt-5 border-t border-gray-100">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <p class="text-xs text-gray-500 mb-2">Didn't receive the OTP code?</p>
            <button type="submit"
                    id="resendBtn"
                    class="text-xs font-semibold text-accent hover:underline bg-transparent border-0 cursor-pointer p-1">
                Resend OTP code (<span id="countdown">60</span>s)
            </button>
        </form>

        <p class="text-center text-sm text-gray-600 mt-5 mb-0">
            <a asp-page="/Account/Login" class="text-muted hover:text-gray-900 text-xs inline-flex items-center gap-1 no-underline">
                <span class="material-symbols-outlined text-[14px]">arrow_back</span> Back to Sign In
            </a>
        </p>
    </div>
</div>

<script>
    const newPasswordInput = document.getElementById('newPasswordInput');
    const strengthBar = document.getElementById('strengthBar');
    const strengthText = document.getElementById('strengthText');
    const confirmPasswordInput = document.getElementById('confirmPasswordInput');
    const matchText = document.getElementById('matchText');

    if (newPasswordInput && strengthBar && strengthText) {
        newPasswordInput.addEventListener('input', function () {
            const pass = this.value;
            let score = 0;
            if (!pass) {
                strengthBar.style.width = '0%';
                strengthText.textContent = 'Strength: Not entered';
                return;
            }

            if (pass.length >= 6) score += 25;
            if (pass.length >= 8) score += 25;
            if (/[A-Z]/.test(pass) && /[a-z]/.test(pass)) score += 25;
            if (/[0-9]/.test(pass) || /[^A-Za-z0-9]/.test(pass)) score += 25;

            strengthBar.style.width = score + '%';
            if (score <= 25) {
                strengthBar.style.background = '#ef4444';
                strengthText.textContent = 'Strength: Weak (Min 6 characters)';
                strengthText.style.color = '#ef4444';
            } else if (score <= 50) {
                strengthBar.style.background = '#f59e0b';
                strengthText.textContent = 'Strength: Medium';
                strengthText.style.color = '#f59e0b';
            } else if (score <= 75) {
                strengthBar.style.background = '#3b82f6';
                strengthText.textContent = 'Strength: Good';
                strengthText.style.color = '#3b82f6';
            } else {
                strengthBar.style.background = '#10b981';
                strengthText.textContent = 'Strength: Strong ✓';
                strengthText.style.color = '#10b981';
            }

            checkMatch();
        });
    }

    if (confirmPasswordInput) {
        confirmPasswordInput.addEventListener('input', checkMatch);
    }

    function checkMatch() {
        if (!confirmPasswordInput || !matchText) return;
        const p1 = newPasswordInput.value;
        const p2 = confirmPasswordInput.value;

        if (!p2) {
            matchText.classList.add('hidden');
            return;
        }

        matchText.classList.remove('hidden');
        if (p1 === p2) {
            matchText.textContent = '✓ Passwords match.';
            matchText.style.color = '#10b981';
        } else {
            matchText.textContent = '✕ Passwords do not match.';
            matchText.style.color = '#ef4444';
        }
    }

    let seconds = 60;
    const resendBtn = document.getElementById('resendBtn');
    const countdownSpan = document.getElementById('countdown');

    if (resendBtn && countdownSpan) {
        resendBtn.disabled = true;
        const timer = setInterval(() => {
            seconds--;
            countdownSpan.textContent = seconds;
            if (seconds <= 0) {
                clearInterval(timer);
                resendBtn.disabled = false;
                resendBtn.innerHTML = "Resend OTP code now";
            }
        }, 1000);
    }
</script>
</body>
</html>
