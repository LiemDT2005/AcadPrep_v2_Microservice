@page
@model Storefront.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập - AcadPrep";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Chào mừng trở lại!</h1>
            <p>Đăng nhập để tiếp tục luyện thi TOEIC</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-error">
                <strong>Thông báo:</strong> @Model.Error
                @if (Model.RequiresOtp)
                {
                    <div style="margin-top: 0.6rem;">
                        <a asp-page="/Account/VerifyOtp" asp-route-email="@Model.UnverifiedEmail" class="btn btn-outline" style="font-size: 0.85rem; padding: 0.35rem 0.75rem; background: #fff;">
                            👉 Nhấn vào đây để xác thực mã OTP ngay
                        </a>
                    </div>
                }
            </div>
        }

        <!-- Standard Login Form -->
        <form method="post">
            <div class="form-group">
                <label asp-for="Email">Địa chỉ Email</label>
                <input asp-for="Email" type="email" placeholder="name@example.com" autofocus />
                <span asp-validation-for="Email" style="color: #b91c1c; font-size: 0.85rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Mật khẩu</label>
                <input asp-for="Password" type="password" placeholder="Nhập mật khẩu của bạn" />
                <span asp-validation-for="Password" style="color: #b91c1c; font-size: 0.85rem;"></span>
            </div>

            <button class="btn btn-block" type="submit">Đăng nhập với Email</button>
        </form>

        <div class="auth-divider">
            <span>HOẶC TIẾP TỤC VỚI</span>
        </div>

        <!-- Official Google Identity Services (One-Tap & Popup) -->
        <form method="post" asp-page-handler="Google" id="googleForm">
            <input type="hidden" asp-for="GoogleIdToken" id="googleIdToken" />
            
            <div id="g_id_onload"
                 data-client_id="@Model.GoogleClientId"
                 data-context="signin"
                 data-callback="handleCredentialResponse"
                 data-auto_prompt="false">
            </div>

            <div style="display: flex; justify-content: center; width: 100%;">
                <div class="g_id_signin"
                     data-type="standard"
                     data-shape="rectangular"
                     data-theme="outline"
                     data-text="continue_with"
                     data-size="large"
                     data-logo_alignment="left"
                     data-width="400">
                </div>
            </div>
        </form>

        <div class="auth-footer">
            Chưa có tài khoản? <a asp-page="/Account/Register">Đăng ký tài khoản mới</a>
        </div>
    </div>
</div>

@section Scripts {
<!-- Thư viện Google Identity Services chính thức từ Google -->
<script src="https://accounts.google.com/gsi/client" async defer></script>
<script>
    function handleCredentialResponse(response) {
        if (response && response.credential) {
            // Nhận Google ID Token chính thức từ Popup của Google
            document.getElementById("googleIdToken").value = response.credential;
            document.getElementById("googleForm").submit();
        } else {
            alert("Không nhận được token xác thực từ Google.");
        }
    }
</script>
}
