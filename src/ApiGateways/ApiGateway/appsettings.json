{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]
      },
      "catalog-route": {
        "ClusterId": "catalog",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]
      },
      "exam-route": {
        "ClusterId": "exam",
        "Match": { "Path": "/exam/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]
      },
      "progress-route": {
        "ClusterId": "progress",
        "Match": { "Path": "/progress/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]
      },
      "learning-route": {
        "ClusterId": "learning",
        "Match": { "Path": "/learning/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]
      },
      "content-route": {
        "ClusterId": "content",
        "Match": { "Path": "/content/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "d1": { "Address": "http://localhost:5001/" } }
      },
      "catalog": {
        "Destinations": { "d1": { "Address": "http://localhost:5002/" } }
      },
      "exam": {
        "Destinations": { "d1": { "Address": "http://localhost:5003/" } }
      },
      "progress": {
        "Destinations": { "d1": { "Address": "http://localhost:5004/" } }
      },
      "learning": {
        "Destinations": { "d1": { "Address": "http://localhost:5005/" } }
      },
      "content": {
        "Destinations": { "d1": { "Address": "http://localhost:5006/" } }
      }
    }
  }
}
