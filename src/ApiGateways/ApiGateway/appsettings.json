{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "ReverseProxy": {
    "Routes": {
      "exam-route": {
        "ClusterId": "exam",
        "Match": { "Path": "/exam/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/{**catch-all}" } ]
      }
    },
    "Clusters": {
      "exam": {
        "Destinations": { "d1": { "Address": "http://localhost:5003/" } }
      }
    }
  }
}
